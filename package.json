{
  "name": "gyblos-node",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "lint": "eslint . && prettier . --check && pnpm tooling:test && pnpm skills:check && pnpm boundaries",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p apps/desktop/tsconfig.renderer.json && tsc -p apps/docs/tsconfig.json",
    "test": "node --import tsx --test \"tests/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "test:lab": "node --import tsx --test \"tests/lab/**/*.test.ts\"",
    "test:all": "node --import tsx --test \"tests/**/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "gate:inference": "node --import tsx lab/harness/src/cli/inference.ts",
    "gate:inference:setup": "node --import tsx lab/harness/scripts/inference-setup.ts",
    "gate:setup": "node --import tsx lab/harness/scripts/setup.ts",
    "gate:preflight": "node --import tsx lab/harness/src/cli/preflight.ts",
    "gate:run": "node --import tsx lab/harness/src/cli/run.ts",
    "gate:buyer": "node --import tsx lab/harness/src/cli/buyer.ts",
    "gate:seller": "node --import tsx lab/harness/scripts/seller.ts",
    "gate:facilitator": "node --import tsx lab/facilitator/src/main.ts",
    "gate:fund": "node --import tsx lab/harness/scripts/fund.ts",
    "gate:challenge": "node --import tsx lab/harness/scripts/challenge.ts",
    "gate:failures": "node --import tsx lab/harness/scripts/failures.ts",
    "gate:exact": "node --import tsx lab/harness/src/cli/exact.ts",
    "gate:channel": "node --import tsx lab/harness/scripts/batch-channel-check.ts",
    "identity:devnet-run": "node --import tsx lab/tools/identity-devnet-run.ts",
    "identity:fixtures": "node --import tsx lab/tools/identity-fixtures.ts",
    "boundaries": "node --import tsx tooling/check-boundaries.ts",
    "skills:check": "node --import tsx tooling/skills-cli.ts check",
    "skills:materialize": "node --import tsx tooling/skills-cli.ts materialize",
    "skills:materialize:replace": "node --import tsx tooling/skills-cli.ts materialize --replace",
    "tooling:test": "node --import tsx --test \"tooling/**/*.test.ts\"",
    "index:invite": "node --import tsx apps/discovery-index/scripts/admin.ts invite",
    "index:revoke": "node --import tsx apps/discovery-index/scripts/admin.ts revoke",
    "index:restore": "node --import tsx apps/discovery-index/scripts/admin.ts restore",
    "node:start": "node --import tsx apps/node/src/main.ts",
    "gyblos": "node --import tsx apps/node/src/cli.ts",
    "buyer:start": "node --import tsx apps/buyer/src/main.ts",
    "buyer:call": "node --import tsx apps/buyer/src/call.ts",
    "buyer:reconcile": "node --import tsx apps/buyer/src/reconcile.ts",
    "buyer:reconcile:paid": "node --import tsx apps/buyer/src/reconcile-paid.ts",
    "buyer:withdraw:paid": "node --import tsx apps/buyer/src/withdraw-paid.ts",
    "buyer:setup": "node --import tsx apps/buyer/src/setup.ts",
    "node:setup": "node --import tsx apps/node/src/setup.ts",
    "node:tokenizer": "node --import tsx apps/node/src/tokenizer.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test:all",
    "buyer:trust": "node --import tsx apps/buyer/src/trust.ts",
    "docs:dev": "pnpm --filter @gyblos/docs dev",
    "docs:build": "pnpm --filter @gyblos/docs build",
    "docs:test": "pnpm --filter @gyblos/docs test:export",
    "desktop:build": "pnpm --filter @gyblos/desktop build",
    "desktop:start": "pnpm desktop:build && pnpm --filter @gyblos/desktop start",
    "desktop:smoke": "pnpm desktop:build && pnpm --filter @gyblos/desktop smoke",
    "desktop:package": "pnpm desktop:build && pnpm --filter @gyblos/desktop package",
    "buyer": "node --import tsx apps/buyer/src/buyer-main.ts",
    "buyer:chat": "node --import tsx apps/buyer/src/chat-cli.ts",
    "buyer:free": "node --import tsx apps/buyer/src/free-main.ts",
    "acceptance:receipts": "pnpm --filter @gyblos/lab-harness acceptance:receipts",
    "acceptance:paid": "node --import tsx tests/support/paid-acceptance-cli.ts",
    "buyer:init": "node --import tsx apps/buyer/src/init.ts"
  },
  "dependencies": {
    "@gyblos/core": "workspace:*",
    "@gyblos/config": "workspace:*",
    "@gyblos/lab-harness": "workspace:*",
    "@gyblos/engine-ollama": "workspace:*",
    "@gyblos/payments-x402": "workspace:*",
    "@gyblos/runtime": "workspace:*",
    "@number0/iroh": "1.1.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.1.0",
    "@x402/core": "2.29.0",
    "@x402/svm": "2.28.0",
    "express": "4.22.3",
    "@gyblos/transport-iroh": "workspace:*",
    "@gyblos/protocol": "workspace:*",
    "@gyblos/node": "workspace:*",
    "@gyblos/buyer": "workspace:*",
    "@gyblos/node-app": "workspace:*",
    "@gyblos/lab-facilitator": "workspace:*",
    "@gyblos/identity": "workspace:*",
    "@gyblos/desktop": "workspace:*",
    "@gyblos/discovery-http": "workspace:*",
    "@gyblos/discovery-index": "workspace:*",
    "@gyblos/telemetry-file": "workspace:*",
    "@gyblos/telemetry-console": "workspace:*",
    "@gyblos/telemetry-otel": "workspace:*",
    "@gyblos/engine-openai": "workspace:*",
    "@gyblos/engine-anthropic": "workspace:*",
    "x402-upto-metered": "workspace:*",
    "@gyblos/payments-upto": "workspace:*",
    "@gyblos/receipt-collector": "workspace:*"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/express": "4.17.21",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.6.0",
    "@opentelemetry/sdk-metrics": "2.12.0"
  }
}
