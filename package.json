{
  "name": "gyblos-payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm format:check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "gate:setup": "node --import tsx scripts/setup.ts",
    "gate:preflight": "node --import tsx apps/cli/src/preflight.ts",
    "gate:run": "node --import tsx apps/cli/src/run.ts",
    "gate:buyer": "node --import tsx apps/cli/src/buyer.ts",
    "gate:seller": "node --import tsx apps/seller/src/main.ts",
    "gate:facilitator": "node --import tsx apps/facilitator/src/main.ts",
    "gate:fund": "node --import tsx scripts/fund.ts",
    "gate:challenge": "node --import tsx scripts/challenge.ts",
    "gate:failures": "node --import tsx scripts/failures.ts",
    "gate:exact": "node --import tsx apps/cli/src/exact.ts"
  },
  "dependencies": {
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.1.0",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.19.0",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
