{
  "name": "gyblos-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier . --check && pnpm boundaries:test && pnpm boundaries",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "gate:inference": "node --import tsx lab/harness/src/cli/inference.ts",
    "gate:inference:setup": "node --import tsx lab/harness/scripts/inference-setup.ts",
    "gate:setup": "node --import tsx lab/harness/scripts/setup.ts",
    "gate:preflight": "node --import tsx lab/harness/src/cli/preflight.ts",
    "gate:run": "node --import tsx lab/harness/src/cli/run.ts",
    "gate:buyer": "node --import tsx lab/harness/src/cli/buyer.ts",
    "gate:seller": "node --import tsx apps/node/src/fixed.ts",
    "gate:facilitator": "node --import tsx apps/facilitator/src/main.ts",
    "gate:fund": "node --import tsx lab/harness/scripts/fund.ts",
    "gate:challenge": "node --import tsx lab/harness/scripts/challenge.ts",
    "gate:failures": "node --import tsx lab/harness/scripts/failures.ts",
    "gate:exact": "node --import tsx lab/harness/src/cli/exact.ts",
    "p2p:docker": "node --import tsx lab/p2p/src/docker-main.ts",
    "p2p:diagnose": "node --import tsx lab/tools/nat-regression.ts",
    "p2p:reconcile": "node --import tsx apps/buyer/src/reconcile.ts",
    "identity:devnet-run": "node --import tsx lab/tools/identity-devnet-run.ts",
    "boundaries": "node --import tsx tooling/check-boundaries.ts",
    "boundaries:test": "node --import tsx --test tooling/boundaries/*.test.ts",
    "node:start": "node --import tsx apps/node/src/main.ts",
    "buyer:start": "node --import tsx apps/buyer/src/main.ts"
  },
  "dependencies": {
    "@gyblos/core": "workspace:*",
    "@gyblos/config": "workspace:*",
    "@gyblos/lab-harness": "workspace:*",
    "@gyblos/engine-ollama": "workspace:*",
    "@gyblos/payments-x402": "workspace:*",
    "@gyblos/runtime": "workspace:*",
    "@number0/iroh": "1.1.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.1.0",
    "@x402/core": "2.28.0",
    "@x402/svm": "2.28.0",
    "express": "4.21.2",
    "@gyblos/transport-iroh": "workspace:*",
    "@gyblos/protocol": "workspace:*",
    "@gyblos/lab-p2p": "workspace:*",
    "@gyblos/node": "workspace:*",
    "@gyblos/buyer": "workspace:*",
    "@gyblos/node-app": "workspace:*",
    "@gyblos/facilitator": "workspace:*",
    "@gyblos/identity": "workspace:*"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/express": "4.17.21",
    "@types/node": "22.19.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
