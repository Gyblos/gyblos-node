{
  "name": "gyblos-node",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "lint": "eslint . && pnpm comments:check && prettier . --check && pnpm tooling:test && pnpm skills:check && pnpm boundaries && pnpm db:check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p apps/desktop/tsconfig.renderer.json && tsc -p apps/docs/tsconfig.json && tsc -p apps/explorer/tsconfig.json",
    "test": "node --import tsx --test \"tests/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "test:lab": "node --import tsx --test \"tests/lab/**/*.test.ts\"",
    "test:all": "node --import tsx --test \"tests/**/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "gate:channel": "node --import tsx lab/harness/scripts/batch-channel-check.ts",
    "identity:devnet-run": "node --import tsx lab/tools/identity-devnet-run.ts",
    "identity:fixtures": "node --import tsx lab/tools/identity-fixtures.ts",
    "boundaries": "node --import tsx tooling/check-boundaries.ts",
    "build:native": "node --import tsx tooling/native-build-cli.ts",
    "build:npm": "node --import tsx tooling/npm-packages-cli.ts",
    "skills:check": "node --import tsx tooling/skills-cli.ts check",
    "comments:check": "node --import tsx tooling/comments-cli.ts check",
    "comments:report": "node --import tsx tooling/comments-cli.ts report",
    "skills:materialize": "node --import tsx tooling/skills-cli.ts materialize",
    "skills:materialize:replace": "node --import tsx tooling/skills-cli.ts materialize --replace",
    "tooling:test": "node --import tsx --test \"tooling/**/*.test.ts\"",
    "security-review": "node --import tsx tooling/security-review/cli.ts",
    "index:invite": "node --import tsx apps/discovery-index/scripts/admin.ts invite",
    "index:revoke": "node --import tsx apps/discovery-index/scripts/admin.ts revoke",
    "index:restore": "node --import tsx apps/discovery-index/scripts/admin.ts restore",
    "index:github-claims": "node --import tsx apps/discovery-index/scripts/github-claims.ts",
    "index:seller-profiles": "node --import tsx apps/discovery-index/scripts/seller-profiles.ts",
    "index:db:generate": "pnpm --filter @gyblos/discovery-index db:generate",
    "collector:db:generate": "pnpm --filter @gyblos/metrics-collector db:generate",
    "db:check": "pnpm --filter @gyblos/discovery-index --filter @gyblos/metrics-collector db:check",
    "db:hashes": "node --import tsx tooling/d1-migrations.ts hashes",
    "node:start": "node --import tsx apps/node/src/bin.ts start",
    "paypal:sandbox": "node --import tsx apps/node/src/paypal-main.ts",
    "gyblos": "node --import tsx apps/node/src/bin.ts",
    "buyer:agent": "node --import tsx apps/buyer/src/bin.ts agent",
    "buyer:withdraw:paid": "node --import tsx apps/buyer/src/bin.ts withdraw",
    "buyer:setup": "node --import tsx apps/buyer/src/bin.ts setup",
    "node:setup": "node --import tsx apps/node/src/bin.ts setup",
    "node:tokenizer": "node --import tsx apps/node/src/bin.ts tokenizer",
    "check": "pnpm typecheck && pnpm lint && pnpm test:all",
    "docs:dev": "pnpm --filter @gyblos/docs dev",
    "docs:build": "pnpm --filter @gyblos/docs build",
    "docs:test": "pnpm --filter @gyblos/docs test:export",
    "desktop:build": "pnpm --filter @gyblos/desktop build",
    "desktop:start": "pnpm desktop:build && pnpm --filter @gyblos/desktop start",
    "desktop:smoke": "pnpm desktop:build && pnpm --filter @gyblos/desktop smoke",
    "desktop:package": "pnpm desktop:build && pnpm --filter @gyblos/desktop package",
    "buyer": "node --import tsx apps/buyer/src/bin.ts start",
    "buyer:chat": "node --import tsx apps/buyer/src/bin.ts chat",
    "buyer:free": "node --import tsx apps/buyer/src/bin.ts free",
    "acceptance:receipts": "pnpm --filter @gyblos/lab-harness acceptance:receipts",
    "buyer:auto": "node --import tsx apps/buyer/src/bin.ts auto",
    "buyer:init": "node --import tsx apps/buyer/src/bin.ts init",
    "explorer:dev": "pnpm --filter @gyblos/explorer dev",
    "explorer:build": "pnpm --filter @gyblos/explorer build",
    "desktop:preview:build": "node --import tsx lab/tools/desktop-preview/build.ts"
  },
  "dependencies": {
    "@gyblos/buyer": "workspace:*",
    "@gyblos/config": "workspace:*",
    "@gyblos/core": "workspace:*",
    "@gyblos/desktop": "workspace:*",
    "@gyblos/discovery-http": "workspace:*",
    "@gyblos/discovery-index": "workspace:*",
    "@gyblos/engine-anthropic": "workspace:*",
    "@gyblos/engine-ollama": "workspace:*",
    "@gyblos/engine-openai": "workspace:*",
    "@gyblos/explorer": "workspace:*",
    "@gyblos/identity": "workspace:*",
    "@gyblos/inference": "workspace:*",
    "@gyblos/lab-harness": "workspace:*",
    "@gyblos/metrics-collector": "workspace:*",
    "@gyblos/node": "workspace:*",
    "@gyblos/node-app": "workspace:*",
    "@gyblos/payments-paypal": "workspace:*",
    "@gyblos/payments-upto": "workspace:*",
    "@gyblos/protocol": "workspace:*",
    "@gyblos/receipt-collector": "workspace:*",
    "@gyblos/runtime": "workspace:*",
    "@gyblos/telemetry-console": "workspace:*",
    "@gyblos/telemetry-file": "workspace:*",
    "@gyblos/telemetry-otel": "workspace:*",
    "@gyblos/transport-iroh": "workspace:*",
    "@number0/iroh": "1.2.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.1.0",
    "@x402/core": "2.29.0",
    "@x402/svm": "2.28.0",
    "express": "4.22.3",
    "x402-upto-metered": "workspace:*"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@solana-program/system": "0.10.0",
    "@types/express": "4.17.21",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.2",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "litesvm": "1.6.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
