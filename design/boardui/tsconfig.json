{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@boardui/*": ["./boardui/*"]
    },
    "noEmit": true
  },
  "include": [
    "boardui/**/*.ts",
    "boardui/**/*.tsx",
    "app/**/*.ts",
    "preview/app/**/*.tsx"
  ]
}
