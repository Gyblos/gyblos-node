{
  // Static docs site for docs.gyblos.com (apps/docs): Cloudflare serves the next build output from
  // out/ with no Worker code. Deploying is a founder-approved manual step; the local redirect test uses the workspace
  // Wrangler dependency. From this directory, build with `pnpm build` before deployment.
  "name": "gyblos-docs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // The first deploy attaches docs.gyblos.com (a gyblos.com zone record) to this Worker.
  "routes": [{ "pattern": "docs.gyblos.com", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    // /en/sellers/beta-guide serves en/sellers/beta-guide.html; unknown paths get 404.html with a 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
