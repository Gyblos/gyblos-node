{
  // Standalone discovery index Worker for discovery.gyblos.com (apps/discovery-index).
  // Deploying is a founder-approved manual step: docs/discovery-index.md has the ops plan.
  // Wrangler is deliberately not a workspace dependency; run the pinned version with
  // `npx wrangler@4.151.1 ...` from this directory.
  //
  // Resources were created with founder approval on 2026-10-24 (D1 gyblos-discovery in ENAM).
  // Removing the d1_databases block and redeploying makes every route fail closed with
  // 503 DISCOVERY_UNAVAILABLE without losing data.
  "name": "gyblos-discovery",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // No request logs: the index must not store or log client IPs.
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DISCOVERY_DB",
      "database_name": "gyblos-discovery",
      "database_id": "d6270b3c-bc9e-4535-8612-d869359266ac",
      "migrations_dir": "migrations",
    },
  ],
  // Rate limits (Cloudflare counts 10 or 60 second windows). namespace_id values must be
  // unused in the account; the website uses 42621001-42621003.
  //   all requests per IP(/64), publishes per IP(/64), publishes per verified NodeId, and
  //   storage reads (sellers cache misses, stale health counts) under one constant key.
  //   Cloudflare counts per location, so the read cap is per Cloudflare location, not worldwide.
  "ratelimits": [
    {
      "name": "DISCOVERY_IP_LIMITER",
      "namespace_id": "42621004",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "DISCOVERY_PUBLISH_LIMITER",
      "namespace_id": "42621005",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "DISCOVERY_NODE_LIMITER",
      "namespace_id": "42621006",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "DISCOVERY_READ_LIMITER",
      "namespace_id": "42621007",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "routes": [{ "pattern": "discovery.gyblos.com", "custom_domain": true }],
  // Publishing also needs the DISCOVERY_PUBLISH_ALLOWLIST secret (approved NodeIds or `*`), set
  // with `secret put` after the first deploy, never here; without it publishes answer 503 and
  // reads keep working.
}
