{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "gyblos",
  "homepage": "https://explorer.gyblos.com",
  "items": [
    {
      "name": "gyblos-theme",
      "type": "registry:theme",
      "title": "Gyblos theme",
      "description": "The Gyblos tokens the board components read: one brand blue, its signal tone for indicators, neutral surfaces, and money, good and bad tones.",
      "cssVars": {
        "theme": {
          "color-bg": "var(--bg)",
          "color-panel": "var(--panel)",
          "color-raised": "var(--raised)",
          "color-line": "var(--line)",
          "color-ink": "var(--ink)",
          "color-muted": "var(--muted)",
          "color-dim": "var(--dim)",
          "color-brand": "var(--brand-blue)",
          "color-signal": "var(--signal)",
          "color-money": "var(--money)",
          "color-good": "var(--good)",
          "color-bad": "var(--bad)",
          "color-chart": "var(--chart)",
          "font-sans": "var(--font-instrument), system-ui, sans-serif",
          "font-mono": "var(--font-jetbrains), ui-monospace, monospace"
        },
        "light": {
          "brand-blue": "#0a28f0",
          "signal": "#0a28f0",
          "bg": "#fcfcfc",
          "panel": "#f4f5f6",
          "raised": "#eceef0",
          "line": "#e4e6e8",
          "ink": "#1c1c1c",
          "muted": "#5f6368",
          "dim": "#6b6b6b",
          "money": "#0f7a3d",
          "good": "#0f7a3d",
          "bad": "#c0362c",
          "chart": "#0a28f0"
        },
        "dark": {
          "brand-blue": "#0a28f0",
          "signal": "#2e6bff",
          "bg": "#090909",
          "panel": "#151515",
          "raised": "#222222",
          "line": "#303030",
          "ink": "#f5f5f5",
          "muted": "#b8b8b8",
          "dim": "#a0a0a0",
          "money": "#4ade80",
          "good": "#4ade80",
          "bad": "#f87171",
          "chart": "#2e6bff"
        }
      }
    },
