// Keeps source usage, payment outcome and linked conversations distinct in a compact dialog.
import { ArrowRight, ChatCircle } from '@phosphor-icons/react';

import type { ActivityEntry } from '../activity-model';
import { DESKTOP_ACTIVITY } from '../constants';
import type { PaypalPaymentReference } from '../payment-reference-model';
import { paypalDollars } from '../paypal-model';
import { activityDate, sessionOutcome } from './activity-presentation';
import { conversationSummary } from './chat-history';
import type { ChatSession } from './chat-state';
import { BUTTON_VARIANT } from './constants';
import { Modal } from './Modal';
import { PaymentReferenceDetails } from './PaymentReference';
import { Badge, Button, Note } from './UI';
import { statusTone, Tag } from './PreviewKit';

type Props = {
  entry: ActivityEntry;
  reference?: PaypalPaymentReference;
  onCopyReference(): Promise<boolean>;
  conversations: ChatSession[];
  close(): void;
  onOpenChat(id: string): void;
  onPayments(): void;
  canReview: boolean;
};
const plural = (count: number, one: string, many: string) =>
  count + ' ' + (count === 1 ? one : many);
export function ActivitySessionDetails({
  entry,
  reference,
  onCopyReference,
  conversations,
  close,
  onOpenChat,
  onPayments,
  canReview,
}: Props) {
  const linked = conversations.filter((item) =>
    conversationSummary(item).paymentSessionIds.includes(entry.id),
  );
  return (
    <Modal
      title={`Session ${entry.id.slice(0, DESKTOP_ACTIVITY.DISPLAY_ID_CHARACTERS)}`}
      close={close}
    >
      <div className="preview-detail-head">
        <Tag tone={statusTone(sessionOutcome(entry))} dot>{sessionOutcome(entry)}</Tag>
        <span className="ui-help-text">PayPal Sandbox · test funds</span>
      </div>
      <dl className="preview-detail-totals">
        <div>
          <dt>Recorded</dt>
          <dd>{paypalDollars(entry.recordedCents)}</dd>
        </div>
        <div>
          <dt>Captured</dt>
          <dd>
            {entry.capturedCents === null
              ? 'Not confirmed'
              : paypalDollars(entry.capturedCents)}
          </dd>
        </div>
        <div>
          <dt>Limit</dt>
          <dd>{paypalDollars(entry.limitCents)}</dd>
        </div>
      </dl>
      <dl className="preview-detail-list">
        <div>
          <dt>Chat</dt>
          <dd>
            {paypalDollars(entry.chatCents)}
            <small>{plural(entry.chatCount, 'reply', 'replies')}</small>
          </dd>
        </div>
        <div>
          <dt>API</dt>
          <dd>
            {paypalDollars(entry.agentCents)}
            <small>{plural(entry.agentCount, 'request', 'requests')}</small>
          </dd>
        </div>
        {entry.unconfirmedCents > 0 && (
          <div>
            <dt>Awaiting confirmation</dt>
            <dd>{paypalDollars(entry.unconfirmedCents)}</dd>
          </div>
        )}
        <div>
          <dt>Last activity</dt>
          <dd>{activityDate(entry.updatedAt)}</dd>
        </div>
      </dl>
      {reference && (
        <PaymentReferenceDetails reference={reference} copy={onCopyReference} />
      )}
      {entry.needsReview && (
        <Note>
          An unfinished operation needs review. An uncertain inference may be
          outside the recorded total. Activity never retries a payment.
        </Note>
      )}
      {linked.length > 0 && (
        <nav className="preview-detail-links" aria-label="Linked conversations">
          <h3>Linked conversations</h3>
          {linked.map((item) => (
            <button
              key={item.id}
              type="button"
              onClick={() => {
                close();
                onOpenChat(item.id);
              }}
            >
              <ChatCircle size={16} aria-hidden="true" />
              <span>{item.title}</span>
              <ArrowRight size={14} aria-hidden="true" />
            </button>
          ))}
        </nav>
      )}
      {canReview && (
        <Button
          variant={BUTTON_VARIANT.SECONDARY}
          onClick={() => {
            close();
            onPayments();
          }}
        >
          Review in Usage &amp; payments
        </Button>
      )}
    </Modal>
  );
}
