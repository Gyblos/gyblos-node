
// Preview-only network selector; it changes no routing, wallet or payment state.
function PreviewNetwork() {
  const showTestnet = usePreviewSetting('showTestnet');
  const network = usePreviewNetwork();
  const choose = (next: (typeof PREVIEW_NETWORKS)[number]) => {
    const params = new URLSearchParams(location.search);
    if (next === PREVIEW_NETWORK.MAINNET) params.set(PREVIEW_QUERY.NETWORK, PREVIEW_QUERY.NETWORK_MAINNET);
    else params.delete(PREVIEW_QUERY.NETWORK);
    history.replaceState(null, '', '?' + params.toString());
    window.dispatchEvent(new Event(PREVIEW_EVENT.NETWORK));
  };
  if (!showTestnet)
    return (
      <div className="preview-network" role="group" aria-label="Network">
        <span className="preview-network-single" data-network="mainnet">
          <span className="preview-network-dot" aria-hidden="true" />
          {PREVIEW_NETWORK.MAINNET}
        </span>
      </div>
    );
  return (
    <div
      className="preview-network"
      role="radiogroup"
      aria-label="Network"
      title={network === PREVIEW_NETWORK.TESTNET ? 'Testnet uses test funds. After December 9 it stays available for developers through Settings.' : 'Mainnet is shown for review; the preview keeps example data.'}
      onKeyDown={(event) => {
        if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return;
        event.preventDefault();
        const next = network === PREVIEW_NETWORK.TESTNET ? PREVIEW_NETWORK.MAINNET : PREVIEW_NETWORK.TESTNET;
        choose(next);
        event.currentTarget.querySelector<HTMLButtonElement>('[data-network="' + next.toLowerCase() + '"]')?.focus();
      }}
    >
      {PREVIEW_NETWORKS.map((item) => (
        <button
          key={item}
          type="button"
          role="radio"
          aria-checked={network === item}
          tabIndex={network === item ? 0 : -1}
          data-network={item.toLowerCase()}
          onClick={() => choose(item)}
        >
          <span className="preview-network-dot" aria-hidden="true" />
          {item}
        </button>
      ))}
    </div>
  );
}
