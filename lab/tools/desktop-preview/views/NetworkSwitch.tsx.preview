
// Preview-only network selector; it changes no routing, wallet or payment state.
const PREVIEW_NETWORKS = ['Testnet', 'Mainnet'] as const;
function PreviewNetwork() {
  const [network, setNetwork] = usePreviewState<(typeof PREVIEW_NETWORKS)[number]>(
    () => (new URLSearchParams(location.search).get('network') === 'mainnet' ? 'Mainnet' : 'Testnet'),
  );
  return (
    <div
      className="preview-network"
      role="radiogroup"
      aria-label="Network"
      title={network === 'Testnet' ? 'Testnet uses test funds and is turned off on December 9.' : 'Mainnet uses real USDC.'}
    >
      {PREVIEW_NETWORKS.map((item) => (
        <button
          key={item}
          type="button"
          role="radio"
          aria-checked={network === item}
          data-network={item.toLowerCase()}
          onClick={() => setNetwork(item)}
        >
          <span className="preview-network-dot" aria-hidden="true" />
          {item}
        </button>
      ))}
      {network === 'Testnet' && <span className="preview-network-note">until Dec 9</span>}
    </div>
  );
}
