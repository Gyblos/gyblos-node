
function FailedTurn({ message, buyer, onReview, onEdit }: {
  message: ChatMessage;
  buyer?: Props['x402'];
  onReview?: () => void;
  onEdit: () => void;
}) {
  const [observation, setObservation] = useState('');
  const declined = message.failureReason === CHAT_FAILURE.DECLINED;
  const shared = message.failureReason === CHAT_FAILURE.KEY_REVIEW;
  const free = message.model.free && message.paymentMethod === PAYMENT_METHOD.USDC;
  const sameSession = message.paymentMethod === PAYMENT_METHOD.USDC &&
    !!message.paymentSessionId && message.paymentSessionId === buyer?.state.summary.sessionId;
  async function checkStatus() {
    const status = await buyer?.run({ action: X402_ACTION.REVIEW });
    setObservation(!status?.summary.available ? 'Payment status is unavailable.'
      : status.summary.blocked ? 'Status checked. Spending is still paused.'
      : 'Status checked. See Payments for the recorded outcome of this turn.');
  }
  const explanation = shared
    ? 'An API key reservation needs review. Its final charge is unknown. Desktop and connected tools are paused.'
    : declined ? 'The seller declined this question before charging you.'
    : free ? 'The free response was interrupted. Any text shown is incomplete.'
    : `The ${message.paymentMethod === PAYMENT_METHOD.PAYPAL ? 'PayPal' : 'USDC'} response was interrupted. The final charge is unknown.`;
  return (
    <article className="chat-answer" aria-label="Assistant">
      {message.text && <MessageText text={message.text} />}
      <Notice>{explanation}{observation && ' ' + observation}</Notice>
      <div className="answer-actions">
        {declined || (free && !shared) ? (
          <Button variant={BUTTON_VARIANT.SECONDARY} onClick={onEdit}>Edit question</Button>
        ) : sameSession ? (
          <Button variant={BUTTON_VARIANT.SECONDARY} disabled={buyer.busy} onClick={() => void checkStatus()}>Check status</Button>
        ) : (
          <Button variant={BUTTON_VARIANT.SECONDARY} onClick={onReview}>Review in Payments</Button>
        )}
      </div>
    </article>
  );
}
