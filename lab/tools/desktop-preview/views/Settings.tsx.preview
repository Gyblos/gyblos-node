// Flat appearance and product information use the shared compact design primitives.
import { Info } from '@phosphor-icons/react';
import { useState } from 'react';

import { Appearance } from './Appearance';
import { BUTTON_VARIANT } from './constants';
import { FormField, FormInput } from './Form';
import { ChoiceMenu, Section } from './Management';
import { Modal } from './Modal';
import { Button, IconButton, PagePanel } from './UI';
import { PreviewKitShowcase } from './PreviewKit';

const FONTS = ['Instrument Sans', 'Inter'] as const;
function chooseFont(font: (typeof FONTS)[number]) {
  const params = new URLSearchParams(location.search);
  if (font === 'Inter') params.set('font', 'inter');
  else params.delete('font');
  location.search = params.toString();
}

const SELLER_ORDER = [
  'Automatic',
  'Free first',
  'Lowest price',
] as const;
function SellerPreferences() {
  const [order, setOrder] =
    useState<(typeof SELLER_ORDER)[number]>('Automatic');
  return (
    <Section title="Sellers">
      <div className="preview-settings-rows">
        <div>
          <span>
            Seller selection
            <small className="ui-help-text">
              Used when a model has more than one seller. Does not change
              routing in this preview.
            </small>
          </span>
          <ChoiceMenu
            label="Seller selection"
            value={order}
            options={SELLER_ORDER}
            onChange={setOrder}
          />
        </div>
      </div>
    </Section>
  );
}

export function Settings({
  light,
  onLightChange,
  version,
}: {
  light: boolean;
  onLightChange(light: boolean): void;
  version: string;
}) {
  const [designOpen, setDesignOpen] = useState(
    () => new URLSearchParams(location.search).get('review') === 'buttons',
  );
  const [aboutOpen, setAboutOpen] = useState(false);
  if (new URLSearchParams(location.search).get('screen') === 'design-system')
    return (
      <PagePanel>
        <PreviewKitShowcase />
      </PagePanel>
    );
  return (
    <PagePanel>
      <Section title="Appearance">
        <div className="preview-settings-rows preview-settings-appearance">
          <Appearance label="Theme" light={light} onLightChange={onLightChange} />
          <div>
            <span>
              Interface font
              <small className="ui-help-text">Preview only: compares the brand font with Inter.</small>
            </span>
            <ChoiceMenu
              label="Interface font"
              value={document.documentElement.dataset.font === 'inter' ? 'Inter' : 'Instrument Sans'}
              options={FONTS}
              onChange={chooseFont}
            />
          </div>
        </div>
      </Section>
      <SellerPreferences />
      <Section title="About">
      <section className="preview-settings-rows">
        <div>
          <span>Design system</span>
          <Button onClick={() => setDesignOpen(true)}>View controls</Button>
        </div>
        <div>
          <span>Preview components</span>
          <Button onClick={() => { location.search = '?screen=design-system'; }}>Open</Button>
        </div>
        <div>
          <span>About Gyblos</span>
          <Button onClick={() => setAboutOpen(true)}>View details</Button>
        </div>
      </section>
      </Section>
      {aboutOpen && (
        <Modal title="About Gyblos" size="sm" close={() => setAboutOpen(false)}>
          <div className="ui-section">
            <p>Gyblos desktop</p>
            <p className="ui-help-text">Version {version}</p>
            <p className="ui-help-text">Local desktop application</p>
          </div>
        </Modal>
      )}
      {designOpen && (
        <Modal title="Design system" size="lg" close={() => setDesignOpen(false)}>
          <div className="ui-section">
            <Section title="Buttons">
              <div className="preview-settings-rows">
                <div>
                  <span>Standard action</span>
                  <Button>Copy</Button>
                </div>
                <div>
                  <span>Primary action</span>
                  <Button variant={BUTTON_VARIANT.PRIMARY}>
                    Connect a tool
                  </Button>
                </div>
                <div>
                  <span>Integrated icon</span>
                  <IconButton label="Information example">
                    <Info size={16} />
                  </IconButton>
                </div>
                <div>
                  <span>Disabled</span>
                  <Button disabled>Create key</Button>
                </div>
              </div>
            </Section>
            <Section title="Typography">
              <p className="ui-help-text">
                Instrument Sans · 14 px interface · 18 px sections
              </p>
            </Section>
            <Section title="Colors">
              <div className="ui-swatch-list">
                <span className="ui-swatch ui-swatch--background">
                  Background
                </span>
                <span className="ui-swatch ui-swatch--panel">Surface</span>
                <span className="ui-swatch ui-swatch--accent">#0A28F0</span>
              </div>
            </Section>
            <Section title="Spacing">
              <p className="ui-help-text">
                4, 8, 12, 16, 24 and 32 px. Controls use a 10 px radius.
              </p>
            </Section>
          </div>
        </Modal>
      )}
    </PagePanel>
  );
}
