const ENTRY_TOOLS = ['OpenCode', 'Codex', 'Claude Code', 'Pi'] as const;
/** Empty-chat shortcut to the Connections setup guide. */
export function PreviewConnectEntry() {
  return (
    <button
      type="button"
      className="preview-connect-entry"
      onClick={() => window.previewNavigate?.(UI_VIEW.CONNECT)}
    >
      <PreviewAgentLogos />
      <span className="preview-connect-copy">
        <strong>Connect a dev tool</strong>
        <small>Use Gyblos models in OpenCode, Codex, Claude Code or Pi.</small>
      </span>
      <CaretRight size={14} aria-hidden="true" />
    </button>
