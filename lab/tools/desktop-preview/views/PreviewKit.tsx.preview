export { statusTone, TONE } from './status-tone';
export type { Tone } from './status-tone';
export { buyerTotal, marketMedian, similarFreeModel } from './market';

/** Buyer-facing price per 1M tokens: the seller net price plus the network fee. */
export const buyerPerMtok = (net: number) => usdPerMtok(buyerTotal(net));

export function Tag({ tone = TONE.NEUTRAL, dot = false, children }: { tone?: Tone; dot?: boolean; children: ReactNode }) {
  return (
    <span className="pk-tag" data-tone={tone}>
      {dot && <span className="pk-dot" aria-hidden="true" />}
      {children}
    </span>
  );
}

/** Signed percentage; `lowerIsBetter` colors a decrease green (prices, latency) and an increase red. */
export function Delta({ percent, lowerIsBetter = false, suffix }: { percent: number; lowerIsBetter?: boolean; suffix?: string }) {
  const rounded = Math.round(percent);
  const good = lowerIsBetter ? rounded < 0 : rounded > 0;
  return (
    <span className="pk-delta" data-tone={rounded === 0 ? TONE.NEUTRAL : good ? TONE.SUCCESS : TONE.DANGER}>
      {(rounded > 0 ? '+' : rounded < 0 ? '−' : '') + Math.abs(rounded) + '%'}
      {suffix && <span className="pk-delta-suffix">{' ' + suffix}</span>}
    </span>
  );
}

/** "20% below median" against the median of the current offers for the same model. */
export function Savings({ price, median }: { price: number; median: number | null }) {
  if (median == null || !(median > 0) || price >= median) return null;
  const percent = Math.round(((median - price) / median) * 100);
  return (
    <span className="pk-delta" data-tone={TONE.SUCCESS} title={'Median of current offers: ' + buyerPerMtok(median) + ' / 1M tokens'}>
      {percent}% below median
    </span>
  );
}

export type Segment = { label: string; value: number; tone: Tone };
export function SegmentedBar({ label, total, segments, format }: {
  label: string;
  total: number;
  segments: readonly Segment[];
  format(value: number): string;
}) {
  const used = segments.reduce((sum, segment) => sum + segment.value, 0);
  const scale = Math.max(total, used, 1);
  return (
    <div className="pk-segmented">
      <div className="pk-segmented-track" aria-hidden="true">
        {segments.map((segment) => (
          <span key={segment.label} data-tone={segment.tone} style={{ width: (segment.value / scale) * 100 + '%' }} />
        ))}
      </div>
      <ul className="pk-legend" aria-label={label}>
        {segments.map((segment) => (
          <li key={segment.label}>
            <span className="pk-dot" data-tone={segment.tone} aria-hidden="true" />
            {segment.label}
            <strong>{format(segment.value)}</strong>
          </li>
        ))}
      </ul>
    </div>
  );
}

export type FilterOption<T extends string> = { value: T; label: string; count: number };
export function FilterChips<T extends string>({ label, options, value, onChange }: {
  label: string;
  options: readonly FilterOption<T>[];
  value: T;
  onChange(value: T): void;
}) {
  const move = (event: KeyboardEvent<HTMLDivElement>) => {
    const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
    if (!step) return;
    event.preventDefault();
    const index = options.findIndex((option) => option.value === value);
    const next = options[(index + step + options.length) % options.length];
    if (!next) return;
    onChange(next.value);
    event.currentTarget.querySelector<HTMLButtonElement>('[data-value="' + next.value + '"]')?.focus();
  };
  return (
    <div className="pk-chips" role="radiogroup" aria-label={label} onKeyDown={move}>
      {options.map((option) => (
        <button
          key={option.value}
          type="button"
          role="radio"
          data-value={option.value}
          aria-checked={option.value === value}
          tabIndex={option.value === value ? 0 : -1}
          onClick={() => onChange(option.value)}
        >
          {option.label}
          <span className="pk-count">{option.count}</span>
        </button>
      ))}
    </div>
  );
}

/** The one code sample: language label, colored tokens and a copy action. `onCopy` returning false keeps "Copy". */
export function CodeBlock({ code, language, title, onCopy, copyDisabled = false }: {
  code: string;
  language: CodeLanguage;
  title?: string;
  onCopy?: () => Promise<unknown> | unknown;
  copyDisabled?: boolean;
}) {
  const [copied, setCopied] = useState(false);
  const tokens = useMemo(() => highlightCode(code, language), [code, language]);
  useEffect(() => {
    if (!copied) return;
    const timer = setTimeout(() => setCopied(false), 1600);
    return () => clearTimeout(timer);
  }, [copied]);
  useEffect(() => setCopied(false), [code]);
  return (
    <figure className="pk-code">
      <figcaption>
        <span className="pk-code-language">{codeLanguageLabel(language)}</span>
        {title && <span className="pk-code-title">{title}</span>}
        <button
          type="button"
          className="pk-code-copy"
          disabled={copyDisabled}
          aria-label={copied ? 'Copied' : 'Copy ' + (title ?? 'code')}
          onClick={() => {
            void Promise.resolve(onCopy ? onCopy() : navigator.clipboard.writeText(code))
              .then((result) => setCopied(onCopy ? result === true : true))
              .catch(() => setCopied(false));
          }}
        >
          {copied ? <Check size={14} aria-hidden="true" /> : <Copy size={14} aria-hidden="true" />}
          <span aria-hidden="true">{copied ? 'Copied' : 'Copy'}</span>
        </button>
      </figcaption>
      <pre tabIndex={0}>
        <code>
          {tokens.map((token, index) =>
            token.kind ? <span key={index} data-token={token.kind}>{token.text}</span> : token.text,
          )}
        </code>
      </pre>
    </figure>
  );
}
const FENCE_LANGUAGE: Record<string, CodeLanguage> = {
  sh: CODE_LANGUAGE.SHELL, bash: CODE_LANGUAGE.SHELL, zsh: CODE_LANGUAGE.SHELL, shell: CODE_LANGUAGE.SHELL, console: CODE_LANGUAGE.SHELL,
  json: CODE_LANGUAGE.JSON, toml: CODE_LANGUAGE.TOML,
  ts: CODE_LANGUAGE.TS, tsx: CODE_LANGUAGE.TS, typescript: CODE_LANGUAGE.TS, js: CODE_LANGUAGE.TS, javascript: CODE_LANGUAGE.TS,
};
/** Language of a Markdown fence such as "```json"; unlabeled fences stay plain text. */
export function fenceLanguage(fence: string): CodeLanguage {
  return FENCE_LANGUAGE[/^```\s*([\w-]*)/.exec(fence)?.[1]?.toLowerCase() ?? ''] ?? CODE_LANGUAGE.TEXT;
}
/** Coding-tool configuration format: Codex uses TOML, Claude Code shell variables, the others JSON. */
export function agentCodeLanguage(tool: AgentTool): CodeLanguage {
  if (tool === AGENT_TOOLS.CODEX) return CODE_LANGUAGE.TOML;
  if (tool === AGENT_TOOLS.CLAUDE_CODE) return CODE_LANGUAGE.SHELL;
  return CODE_LANGUAGE.JSON;
}

export type DetailItem = { label: string; value: ReactNode; note?: string };
/** The one detail-dialog summary: status line, headline numbers, then a key/value list. */
export function DetailSummary({ status, meta, totals, rows = [] }: {
  status?: { label: string; tone: Tone };
  meta?: string;
  totals: DetailItem[];
  rows?: DetailItem[];
}) {
  return (
    <div className="pk-detail">
      {(status || meta) && (
        <div className="preview-detail-head">
          {status && <Tag tone={status.tone} dot>{status.label}</Tag>}
          {meta && <span className="ui-help-text">{meta}</span>}
        </div>
      )}
      <dl className="preview-detail-totals">
        {totals.map((item) => (
          <div key={item.label}>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
      {rows.length > 0 && (
        <dl className="preview-detail-list">
          {rows.map((item) => (
            <div key={item.label}>
              <dt>{item.label}</dt>
              <dd>
                <span>{item.value}</span>
                {item.note && <small>{item.note}</small>}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  );
}

export function Panel({ title, children }: { title: string; children: ReactNode }) {
  return (
    <section className="preview-panel" aria-label={title}>
      <h3>{title}</h3>
      {children}
    </section>
  );
}

export function PreviewKitShowcase() {
  const [filter, setFilter] = useState<'all' | 'chat' | 'api'>('all');
  const usd = (value: number) => value.toFixed(3) + ' USDC';
  return (
    <div className="pk-showcase">
      <Panel title="Tags">
        <div className="pk-row">
          <Tag tone={TONE.SUCCESS} dot>Active</Tag>
          <Tag tone={TONE.INFO} dot>Session open</Tag>
          <Tag tone={TONE.WARNING}>Demo</Tag>
          <Tag tone={TONE.DANGER} dot>Failed</Tag>
          <Tag>Revoked</Tag>
        </div>
      </Panel>
      <Panel title="Deltas and savings">
        <div className="pk-row">
          <Delta percent={12.4} suffix="this week" />
          <Delta percent={-6} suffix="this week" />
          <Delta percent={-18} lowerIsBetter suffix="latency" />
          <Savings price={0.12} median={0.24} />
        </div>
      </Panel>
      <Panel title="Segmented usage">
        <SegmentedBar
          label="Spending limit used"
          total={1}
          format={usd}
          segments={[
            { label: 'Chat', value: 0.18, tone: TONE.INFO },
            { label: 'Coding tools', value: 0.27, tone: TONE.SUCCESS },
            { label: 'Research', value: 0.09, tone: TONE.WARNING },
          ]}
        />
      </Panel>
      <Panel title="Filter chips">
        <FilterChips
          label="Usage source"
          value={filter}
          onChange={setFilter}
          options={[
            { value: 'all', label: 'All', count: 39 },
            { value: 'chat', label: 'Chat', count: 12 },
            { value: 'api', label: 'API', count: 27 },
          ]}
        />
      </Panel>
    </div>
  );
}

/* Synthetic buyer balance for the funds-needed flow; it never reads or moves real funds. */
declare global {
  interface Window {
    previewFunds?: { atomic: number; open: boolean };
  }
}
const FUNDS = { READY_ATOMIC: 2_000_000, ATOMIC_PER_USDC: 1_000_000 } as const;
const fundsListeners = new Set<() => void>();
function fundsState() {
  window.previewFunds ??= {
    atomic: new URLSearchParams(location.search).get('funding') === 'ready' ? FUNDS.READY_ATOMIC : 0,
    open: false,
  };
  return window.previewFunds;
}
function subscribeFunds(listener: () => void) {
  fundsListeners.add(listener);
  return () => {
    fundsListeners.delete(listener);
  };
}
function updateFunds(next: Partial<{ atomic: number; open: boolean }>) {
  window.previewFunds = { ...fundsState(), ...next };
  fundsListeners.forEach((listener) => listener());
}
export function openPreviewFunds() {
  updateFunds({ open: true });
}
export function usePreviewBalance() {
  return useSyncExternalStore(subscribeFunds, () => fundsState().atomic);
}
export function previewUsdc(atomic: number) {
  return (atomic / FUNDS.ATOMIC_PER_USDC).toFixed(2) + ' USDC';
}
export function usePreviewFunds(model: { name: string; free: boolean }, applies: boolean) {
  const atomic = usePreviewBalance();
  return { model, blocked: applies && !model.free && atomic === 0 };
}

export const PREVIEW_EVENT = { NETWORK: 'preview:network' } as const;

function subscribeNetwork(listener: () => void) {
  window.addEventListener(PREVIEW_EVENT.NETWORK, listener);
  return () => window.removeEventListener(PREVIEW_EVENT.NETWORK, listener);
}

export function useSpending() {
  const keys = useUsdcApiKeys().state.snapshot;
  const account = window.previewAccountBudget.current();
  const keySpend = (keys?.keys ?? []).reduce((sum, key) => sum + BigInt(key.spentAtomic), 0n);
  const spent = BigInt(account.spentAtomic) + keySpend;
  const limited = account.limited;
  const limit = BigInt(account.limitAtomic);
  return { keys, spent, limit, limited, remaining: limit > spent ? limit - spent : 0n };
}

/** Context tab attached above the composer: network, balance and limit, or the funds-needed notice. */
export function PreviewComposerTab({
  funds,
  models,
  buyer,
  onSelectModel,
}: {
  funds: ReturnType<typeof usePreviewFunds>;
  models: readonly { id: string; name: string; free: boolean }[];
  buyer?: X402View;
  onSelectModel: (id: string) => void;
}) {
  const open = useSyncExternalStore(subscribeFunds, () => fundsState().open);
  const atomic = usePreviewBalance();
  const { spent, limit, limited } = useSpending();
  const percent = limited && limit > 0n ? Math.min(100, Number((spent * 100n) / limit)) : 0;
  const network = useSyncExternalStore(subscribeNetwork, () =>
    new URLSearchParams(location.search).get('network') === 'mainnet' ? 'Mainnet' : 'Testnet',
  );
  const free = models.find((item) => item.free && item.name === funds.model.name) ?? similarFreeModel(models, funds.model.name);
  return (
    <>
      <div className="pk-composer-tab" data-warning={funds.blocked || undefined}>
        {funds.blocked ? (
          <>
            <Warning size={15} weight="fill" aria-hidden="true" />
            <p role="status">
              <strong>{funds.model.name}</strong> needs USDC to send. Your draft is kept.
            </p>
            {free && (
              <Button onClick={() => onSelectModel(free.id)}>
                {free.name === funds.model.name ? 'Use a free seller' : 'Use ' + free.name}
              </Button>
            )}
            <Button variant={BUTTON_VARIANT.PRIMARY} onClick={openPreviewFunds}>
              Add funds
            </Button>
          </>
        ) : (
          <>
            <span className="pk-tab-item" data-network={network.toLowerCase()}>
              <span className="pk-dot" aria-hidden="true" />
              {network}
            </span>
            <span className="pk-tab-item">
              <Wallet size={14} aria-hidden="true" />
              {previewUsdc(atomic)}
            </span>
            <span className="pk-tab-item pk-tab-limit" title="Spending limit used">
              <span
                className="pk-ring"
                aria-hidden="true"
                style={{ background: `conic-gradient(var(--ink) ${percent * 3.6}deg, var(--line) 0deg)` }}
              />
              {!limited ? 'No limit' : limit === 0n ? 'Free models only' : percent + '% of limit'}
            </span>
          </>
        )}
      </div>
      <MotionPresence>
        {open && (
          <Modal title="Add funds" description="Your draft stays in the chat." close={() => updateFunds({ open: false })}>
            <AddBuyerFunds />
            <Button className="wide" onClick={() => updateFunds({ atomic: FUNDS.READY_ATOMIC, open: false })}>
              Preview: simulate 2 USDC arriving
            </Button>
          </Modal>
        )}
      </MotionPresence>
    </>
  );
}

