/* Synthetic buyer balance for the funds-needed flow; it never reads or moves real funds. */
declare global {
  interface Window {
    previewFunds?: { atomic: number; open: boolean; host?: FundsHost };
  }
}
export const FUNDS_HOST = { CHAT: 'chat', PAYMENTS: 'payments' } as const;
type FundsHost = (typeof FUNDS_HOST)[keyof typeof FUNDS_HOST];
const FUNDS = { READY_ATOMIC: 2_000_000, ATOMIC_PER_USDC: 1_000_000 } as const;
const fundsListeners = new Set<() => void>();
function fundsState() {
  window.previewFunds ??= {
    atomic: new URLSearchParams(location.search).get('funding') === 'ready' ? FUNDS.READY_ATOMIC : 0,
    open: false,
  };
  return window.previewFunds;
}
function subscribeFunds(listener: () => void) {
  fundsListeners.add(listener);
  return () => {
    fundsListeners.delete(listener);
  };
}
function updateFunds(next: Partial<{ atomic: number; open: boolean; host: FundsHost }>) {
  window.previewFunds = { ...fundsState(), ...next };
  fundsListeners.forEach((listener) => listener());
}
export function openPreviewFunds(host: FundsHost = FUNDS_HOST.CHAT) {
  updateFunds({ open: true, host });
}
export function usePreviewBalance() {
  return useSyncExternalStore(subscribeFunds, () => fundsState().atomic);
}
export function previewUsdc(atomic: number) {
  return (atomic / FUNDS.ATOMIC_PER_USDC).toFixed(2) + ' USDC';
}
type FundsModel = { id: string; name: string; free: boolean };
export function usePreviewFunds(model: { name: string; free: boolean }, applies: boolean, models: readonly FundsModel[]) {
  const atomic = usePreviewBalance();
  const fallback = usePreviewSetting('freeFallback');
  const broke = applies && !model.free && atomic === 0;
  // The free-model fallback needs a free model to answer; without one, sending stays blocked.
  const free = models.find((item) => item.free && item.name === model.name) ?? similarFreeModel(models, model.name);
  return { model, free, blocked: broke && !(fallback && free), fallback: broke && fallback && !!free };
}

/* Account-wide buyer settings (the buyer config.toml in the product); synthetic and kept until reload. */
export const SELLER_MODES = ['Auto', 'Cheapest', 'Fastest', 'Most reliable'] as const;
export type SellerMode = (typeof SELLER_MODES)[number];
// Fastest and Most reliable stay visible with "Soon" until real latency and reliability data exist.
export const READY_SELLER_MODES: readonly SellerMode[] = ['Auto', 'Cheapest'];
export const PREVIEW_COPY = {
  sellerModeSoon: 'Available once real latency and reliability data exist',
  sellerModeSoonShort: 'Needs real performance data',
  freeFallbackLabel: 'Use a free model when out of funds',
  needsFunds: 'Needs funds · Add funds, or turn on the free-model fallback in Settings.',
  fallbackNext: (model: string) => 'Out of funds: answers will come from free model ' + model + '. Paid models resume when you add funds.',
  keyAtLimit: "At this key's limit, raise it in Connections.",
  fallbackUsed: (model: string) => 'Out of funds: answered with free model ' + model + '. Paid models resume when you add funds.',
  keyOutOfFunds: 'Out of funds. Add funds in Gyblos, or turn on "Use a free model when out of funds" in Settings.',
  pinnedUnavailable: (seller: string, replacement: string, mode: SellerMode) => seller + ' is unavailable. Using ' + replacement + ' (' + mode + ') for now.',
  pinnedNoReplacement: (seller: string) => seller + ' is unavailable. Choose another seller to continue.',
} as const;
type PreviewSettings = { freeFallback: boolean; showTestnet: boolean; sellerMode: SellerMode };
declare global {
  interface Window {
    previewSettings?: PreviewSettings;
    previewChatSeed?: { ages: Record<string, number>; pinned: string[]; unread: string[] };
  }
}
const settingsListeners = new Set<() => void>();
function settingsState() {
  const query = new URLSearchParams(location.search);
  window.previewSettings ??= {
    freeFallback: query.get('fallback') === 'on',
    showTestnet: query.get('testnet') !== 'hidden',
    sellerMode: 'Auto',
  };
  return window.previewSettings;
}
function subscribeSettings(listener: () => void) {
  settingsListeners.add(listener);
  return () => {
    settingsListeners.delete(listener);
  };
}
export function usePreviewSetting<K extends keyof PreviewSettings>(key: K) {
  return useSyncExternalStore(subscribeSettings, () => settingsState()[key]);
}
export function setPreviewSetting<K extends keyof PreviewSettings>(key: K, value: PreviewSettings[K]) {
  window.previewSettings = { ...settingsState(), [key]: value };
  settingsListeners.forEach((listener) => listener());
}
export function previewSetting<K extends keyof PreviewSettings>(key: K) {
  return settingsState()[key];
}

export const PREVIEW_EVENT = { NETWORK: 'preview:network', UPDATE: 'preview:update' } as const;
export const PREVIEW_NETWORKS = ['Testnet', 'Mainnet'] as const;

let availableUpdate: string | null = null;
let stopUpdates: (() => void) | undefined;
const updateListeners = new Set<() => void>();
function subscribeUpdate(listener: () => void) {
  updateListeners.add(listener);
  const bridge = window.desktopUpdate;
  if (!stopUpdates && bridge)
    stopUpdates = observeDesktopUpdates(() => bridge.run(DESKTOP_UPDATE.STATUS), (update) => {
      availableUpdate = update.available;
      updateListeners.forEach((notify) => notify());
    });
  return () => {
    updateListeners.delete(listener);
    if (updateListeners.size) return;
    stopUpdates?.();
    stopUpdates = undefined;
    availableUpdate = null;
  };
}
const readUpdate = () => availableUpdate;
/** One shared poll of the host update bridge (synthetic in the preview): the newer version, or null. */
function usePreviewUpdate(): string | null {
  return useSyncExternalStore(subscribeUpdate, readUpdate);
}
const NewerVersion = createContext<string | null>(null);
/** The version newer than the installed one, as shown by the status bar; null when up to date. */
export function usePreviewNewerVersion(): string | null {
  return useContext(NewerVersion);
}
export function openPreviewUpdate() {
  window.dispatchEvent(new Event(PREVIEW_EVENT.UPDATE));
}
/** The one "new version" affordance: an info pill that opens the update dialog. */
export function PreviewUpdateButton({ version, onClick }: { version: string; onClick(): void }) {
  return (
    <Button className="pk-update" onClick={onClick}>
      <ArrowCircleUp size={14} weight="fill" aria-hidden="true" />
      Update to {version}
    </Button>
  );
}
function PreviewUpdateDialog({
  current,
  available,
  close,
  restoreFocus,
}: {
  current: string;
  available: string;
  close(): void;
  restoreFocus?: () => void;
}) {
  const restore = useRef(restoreFocus);
  useEffect(() => () => {
    const focus = restore.current;
    if (focus) requestAnimationFrame(focus);
  }, []);
  return (
    <Modal title={'Gyblos ' + available} description="A new desktop version is available." size="sm" close={close}>
      <p className="ui-help-text">
        You have {current}. Your chats, API keys and wallet stay on this computer when you update.
      </p>
      <FormActions>
        <Button onClick={close}>Later</Button>
        <Button
          variant={BUTTON_VARIANT.PRIMARY}
          onClick={() => {
            close();
            void window.desktopUpdate?.run(DESKTOP_UPDATE.OPEN).catch(() => {});
          }}
        >
          Open download page
        </Button>
      </FormActions>
    </Modal>
  );
}
/** Bottom bar of the desktop window: system status on the left, update and version on the right. */
export function PreviewStatusBar({ status, version }: { status: ReactNode; version: string }) {
  const available = usePreviewUpdate();
  const footer = useRef<HTMLElement>(null);
  const [open, setOpen] = useState(false);
  const [chained, setChained] = useState(false);
  useEffect(() => {
    const show = () => {
      setChained(true);
      setOpen(true);
    };
    window.addEventListener(PREVIEW_EVENT.UPDATE, show);
    return () => window.removeEventListener(PREVIEW_EVENT.UPDATE, show);
  }, []);
  const newer = available && available !== version ? available : null;
  return (
    <>
      <footer ref={footer} className="preview-status-bar" aria-label="App status">
        <NewerVersion.Provider value={newer}>{status}</NewerVersion.Provider>
        <span className="preview-status-end">
          {newer && (
            <PreviewUpdateButton
              version={newer}
              onClick={() => {
                setChained(false);
                setOpen(true);
              }}
            />
          )}
          <span className="preview-version">Gyblos {version}</span>
        </span>
      </footer>
      <MotionPresence>
        {open && newer && (
          <PreviewUpdateDialog
            current={version}
            available={newer}
            close={() => setOpen(false)}
            restoreFocus={chained ? () => footer.current?.querySelector<HTMLElement>('.preview-status-trigger')?.focus() : undefined}
          />
        )}
      </MotionPresence>
    </>
  );
}
export type PreviewNetworkName = (typeof PREVIEW_NETWORKS)[number];

function subscribeNetwork(listener: () => void) {
  window.addEventListener(PREVIEW_EVENT.NETWORK, listener);
  return () => window.removeEventListener(PREVIEW_EVENT.NETWORK, listener);
}
/** The one network reading for the title bar and the composer: the URL, or Mainnet while Testnet is hidden. */
export function usePreviewNetwork(): PreviewNetworkName {
  const showTestnet = usePreviewSetting('showTestnet');
  return useSyncExternalStore(subscribeNetwork, (): PreviewNetworkName =>
    !showTestnet || new URLSearchParams(location.search).get('network') === 'mainnet' ? 'Mainnet' : 'Testnet',
  );
}

export function useSpending() {
  const keys = useUsdcApiKeys().state.snapshot;
  const account = window.previewAccountBudget.current();
  const keySpend = (keys?.keys ?? []).reduce((sum, key) => sum + BigInt(key.spentAtomic), 0n);
  const spent = BigInt(account.spentAtomic) + keySpend;
  const limited = account.limited;
  const limit = BigInt(account.limitAtomic);
  return { keys, spent, limit, limited, freeOnly: limited && limit === 0n, remaining: limit > spent ? limit - spent : 0n };
}

/** Context tab attached above the composer: network, balance and limit, or the funds-needed notice. */
export function PreviewComposerTab({
  funds,
  models,
  onSelectModel,
}: {
  funds: ReturnType<typeof usePreviewFunds>;
  models: readonly { id: string; name: string; free: boolean }[];
  onSelectModel: (id: string) => void;
}) {
  const atomic = usePreviewBalance();
  const { spent, limit, limited, freeOnly } = useSpending();
  const percent = limited && limit > 0n ? Math.min(100, Number((spent * 100n) / limit)) : 0;
  const network = usePreviewNetwork();
  const free = funds.free;
  return (
    <>
      <div className="pk-composer-tab" data-warning={funds.blocked || funds.fallback || undefined}>
        {funds.fallback && free ? (
          <>
            <Info size={15} weight="fill" aria-hidden="true" />
            <p role="status">{PREVIEW_COPY.fallbackNext(free.name)}</p>
            <Button variant={BUTTON_VARIANT.PRIMARY} onClick={() => openPreviewFunds()}>
              Add funds
            </Button>
          </>
        ) : funds.blocked ? (
          <>
            <Warning size={15} weight="fill" aria-hidden="true" />
            <p role="status">
              <strong>{funds.model.name}</strong> needs USDC to send. Your draft is kept.
            </p>
            {free && (
              <Button onClick={() => onSelectModel(free.id)}>
                {free.name === funds.model.name ? 'Use a free seller' : 'Use ' + free.name}
              </Button>
            )}
            <Button variant={BUTTON_VARIANT.PRIMARY} onClick={() => openPreviewFunds()}>
              Add funds
            </Button>
          </>
        ) : (
          <>
            <span className="pk-tab-item" data-network={network.toLowerCase()}>
              <span className="pk-dot" aria-hidden="true" />
              {network}
            </span>
            <span className="pk-tab-item">
              <Wallet size={14} aria-hidden="true" />
              {previewUsdc(atomic)}
            </span>
            <span className="pk-tab-item pk-tab-limit" title="Spending limit used">
              <span
                className="pk-ring"
                aria-hidden="true"
                style={{ background: `conic-gradient(var(--ink) ${percent * 3.6}deg, var(--line) 0deg)` }}
              />
              {!limited ? 'No limit' : freeOnly ? 'Free models only' : percent + '% of limit'}
            </span>
          </>
        )}
      </div>
      <PreviewFundsDialog host={FUNDS_HOST.CHAT} description="Your draft stays in the chat." />
    </>
  );
}

/* Testnet funds come from the Circle faucet; Mainnet funds are real USDC, so the faucet never appears there. */
export function PreviewFundsDialog({ host, description }: { host: FundsHost; description?: string }) {
  const open = useSyncExternalStore(subscribeFunds, () => fundsState().open && (fundsState().host ?? FUNDS_HOST.CHAT) === host);
  const network = usePreviewNetwork();
  return (
    <MotionPresence>
      {open && (
        <Modal title={'Add funds · ' + network} description={description} close={() => updateFunds({ open: false })}>
          {network === 'Testnet' ? <AddBuyerFunds /> : <PreviewMainnetFunds />}
          <Button className="wide" onClick={() => updateFunds({ atomic: FUNDS.READY_ATOMIC, open: false })}>
            Preview: simulate 2 USDC arriving
          </Button>
        </Modal>
      )}
    </MotionPresence>
  );
}
function PreviewMainnetFunds() {
  const address = useDesktopWallet().address;
  return (
    <div className="ui-form">
      <p className="ui-help-text">Send USDC on Solana to your buyer wallet. Other tokens or networks cannot be recovered.</p>
      {address && (
        <CopyField id="preview-mainnet-address" label="Buyer wallet address" value={address} actionLabel="Copy address" onCopy={() => void navigator.clipboard.writeText(address)} />
      )}
      <ul className="preview-method-list">
        <li className="preview-method-row" aria-label="PayPal">
          <span className="ui-icon-tile" aria-hidden="true"><PaypalLogo size={18} /></span>
          <div className="preview-method-copy">
            <span className="preview-method-name"><h3>PayPal</h3><Tag tone={TONE.WARNING}>Demo</Tag></span>
            <span className="ui-help-text">Choose PayPal in Usage &amp; payments.</span>
          </div>
        </li>
        <li className="preview-method-row" aria-label="Card">
          <span className="ui-icon-tile" aria-hidden="true"><CreditCard size={18} /></span>
          <div className="preview-method-copy">
            <span className="preview-method-name"><h3>Card</h3><Tag>Soon</Tag></span>
            <span className="ui-help-text">Card top-ups are planned; nothing is connected yet.</span>
          </div>
        </li>
      </ul>
    </div>
  );
}

