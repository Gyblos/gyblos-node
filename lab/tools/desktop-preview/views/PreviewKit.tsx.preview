}
export function CompactAmount({ id, value, onChange, unit, parse, format, step, invalid, placeholder, describedBy, onEnter, onEscape }: {
  id: string; value: string; onChange(value: string): void; unit: string;
  parse(value: string): bigint | null; format(atomic: bigint): string; step: bigint;
  invalid: boolean; placeholder?: string; describedBy?: string; onEnter?(): void; onEscape?(): void;
}) {
  const atomic = value.trim() ? parse(value.trim()) : null;
  const nudge = (direction: bigint) => {
    const next = (atomic ?? 0n) + direction * step;
    onChange(format(next > 0n ? next : 0n));
  };
  return (
    <div className="preview-compact-amount" data-invalid={invalid}>
      <input id={id} inputMode="decimal" autoComplete="off" placeholder={placeholder} value={value}
        aria-invalid={invalid} aria-describedby={describedBy}
        onChange={event => onChange(event.target.value.replace(',', '.'))}
        onKeyDown={event => {
          if (event.key === 'ArrowUp' || event.key === 'ArrowDown') { event.preventDefault(); nudge(event.key === 'ArrowUp' ? 1n : -1n); }
          if (event.key === 'Enter' && onEnter) { event.preventDefault(); onEnter(); }
          if (event.key === 'Escape' && onEscape) { event.preventDefault(); onEscape(); }
        }} />
      <span className="preview-amount-unit">{unit}</span>
      <span className="preview-steppers">
        <IconButton label={'Decrease by ' + format(step) + ' ' + unit} disabled={!atomic} onClick={() => nudge(-1n)}><Minus size={14} /></IconButton>
        <IconButton label={'Increase by ' + format(step) + ' ' + unit} onClick={() => nudge(1n)}><Plus size={14} /></IconButton>
      </span>
    </div>
  );
}
export function AmountEditor({ id, label, value, onChange, unit, presets, empty, parse, format, step, error, help, onEnter, disabled = false, autoFocus = false }: {
  id: string; label: string; value: string; onChange(value: string): void; unit: string;
  presets: readonly { value: string; label: string }[]; empty?: { label: string; placeholder: string };
  parse(value: string): bigint | null; format(atomic: bigint): string; step: bigint;
  error: string; help: ReactNode; onEnter?(): void; disabled?: boolean; autoFocus?: boolean;
}) {
  const text = value.trim();
  const atomic = text ? parse(text) : null;
  const nudge = (direction: bigint) => {
    const next = (atomic ?? 0n) + direction * step;
    onChange(format(next > 0n ? next : 0n));
  };
  return (
    <div className="preview-amount-editor">
      <label htmlFor={id} className="preview-limit-label">{label}</label>
      <div className="preview-amount-field" data-invalid={!!error}>
        <input id={id} autoFocus={autoFocus} inputMode="decimal" autoComplete="off" placeholder={empty?.placeholder} disabled={disabled}
          value={value} aria-invalid={!!error} aria-describedby={id + '-help'}
          onChange={event => onChange(event.target.value.replace(',', '.'))}
          onKeyDown={event => {
            if (event.key === 'ArrowUp' || event.key === 'ArrowDown') { event.preventDefault(); nudge(event.key === 'ArrowUp' ? 1n : -1n); }
            if (event.key === 'Enter' && onEnter) { event.preventDefault(); onEnter(); }
          }} />
        <span className="preview-amount-unit">{unit}</span>
        <span className="preview-steppers">
          <IconButton label={'Decrease by ' + format(step) + ' ' + unit} disabled={disabled || !atomic} onClick={() => nudge(-1n)}><Minus size={14} /></IconButton>
          <IconButton label={'Increase by ' + format(step) + ' ' + unit} disabled={disabled} onClick={() => nudge(1n)}><Plus size={14} /></IconButton>
        </span>
      </div>
      <div className="preview-amount-presets" role="group" aria-label="Quick amounts">
        {presets.map(preset => (
          <button key={preset.value} type="button" disabled={disabled} aria-pressed={text === preset.value} onClick={() => onChange(preset.value)}>{preset.label}</button>
        ))}
        {empty && <button type="button" disabled={disabled} aria-pressed={!text} onClick={() => onChange('')}>{empty.label}</button>}
      </div>
      <p id={id + '-help'} className={error ? 'preview-field-error' : 'ui-help-text'} role={error ? 'alert' : undefined}>{error || help}</p>
    </div>
  );
}

/** Overlapping logos of the coding tools a Gyblos API key connects. */
export function PreviewAgentLogos() {
  return (
    <span className="preview-connect-logos" aria-hidden="true">
      {ENTRY_TOOLS.map((tool) => (
        <span key={tool} className="preview-tool-logo">
          <ServiceLogo service={tool} />
        </span>
      ))}
    </span>
  );
}

type ConversationState = { pinned: string[]; unread: string[]; titles: Record<string, string>; removed: string[] };
let conversationState: ConversationState | undefined;
const conversationListeners = new Set<() => void>();
function readConversations(): ConversationState {
  conversationState ??= {
    pinned: window.previewChatSeed?.pinned ?? [],
    unread: window.previewChatSeed?.unread ?? [],
    titles: {},
    removed: [],
  };
  return conversationState;
}
function updateConversations(change: (state: ConversationState) => Partial<ConversationState>) {
  const state = readConversations();
  conversationState = { ...state, ...change(state) };
  conversationListeners.forEach((listener) => listener());
}
function subscribeConversations(listener: () => void) {
  conversationListeners.add(listener);
  return () => {
    conversationListeners.delete(listener);
  };
}
function usePreviewConversations() {
  return useSyncExternalStore(subscribeConversations, readConversations);
}
const without = (list: string[], id: string) => list.filter((item) => item !== id);
function togglePin(id: string) {
  updateConversations((state) => ({ pinned: state.pinned.includes(id) ? without(state.pinned, id) : [...state.pinned, id] }));
}
function markUnread(id: string) {
  updateConversations((state) => (state.unread.includes(id) ? {} : { unread: [...state.unread, id] }));
}
function markRead(id: string) {
  updateConversations((state) => (state.unread.includes(id) ? { unread: without(state.unread, id) } : {}));
}

type ChatSessionItem = ReturnType<ChatController['getSnapshot']>['sessions'][number];
function conversationTitle(session: ChatSessionItem, titles: Record<string, string>) {
  return titles[session.id] ?? (session.messages.length ? session.title : session.draft.trim() || session.title);
}
const DAY_GROUPS = ['Today', 'Yesterday', 'Previous 7 days', 'Older'] as const;
function dayGroup(days: number): (typeof DAY_GROUPS)[number] {
  return days < 1 ? 'Today' : days < 2 ? 'Yesterday' : days < 8 ? 'Previous 7 days' : 'Older';
}
const CHAT_FILTERS = ['All chats', 'Unread', 'Pinned'] as const;
type ChatFilter = (typeof CHAT_FILTERS)[number];

/** Running spinner or unread dot beside a conversation title. */
function PreviewChatState({ state }: { state: 'running' | 'unread' }) {
  return (
    <span
      className="preview-chat-state"
      data-state={state}
      role="img"
      aria-label={state === 'running' ? 'Answering' : 'New answer'}
    />
  );
}

/** Conversation panel beside the rail: new chat, connect agents, then pinned and dated conversations. */
export function PreviewConversationPanel({ chat, view, collapsed, loading, onNewChat, onOpenChat, onConnect }: {
  chat: ChatController;
  view: View;
  collapsed: boolean;
  loading: boolean;
  onNewChat(): void;
  onOpenChat(id: string): void;
  onConnect(): void;
}) {
  const { sessions, activeId } = useSyncExternalStore(chat.subscribe, chat.getSnapshot);
  const state = usePreviewConversations();
  const [searching, setSearching] = useState(false);
  const [search, setSearch] = useState('');
  const [filter, setFilter] = useState<ChatFilter>('All chats');
  const running = useRef(new Set<string>());
  useEffect(() => {
    const now = new Set(sessions.filter((session) => session.run || session.paypalRun).map((session) => session.id));
    for (const id of running.current) if (!now.has(id) && id !== activeId) markUnread(id);
    running.current = now;
  }, [sessions, activeId]);
  useEffect(() => {
    if (view === UI_VIEW.CHAT) markRead(activeId);
  }, [activeId, view]);
  const query = search.trim().toLowerCase();
  const visible = sessions
    .filter((session) => session.messages.length || session.draft.trim())
    .filter((session) => !state.removed.includes(session.id))
    .filter((session) => conversationTitle(session, state.titles).toLowerCase().includes(query))
    .filter((session) =>
      filter === 'Unread' ? state.unread.includes(session.id) : filter === 'Pinned' ? state.pinned.includes(session.id) : true,
    )
    .slice()
    .reverse();
  const ages = window.previewChatSeed?.ages ?? {};
  const groups = [
    { title: 'Pinned', items: visible.filter((session) => state.pinned.includes(session.id)) },
    ...DAY_GROUPS.map((title) => ({
      title,
      items: visible.filter((session) => !state.pinned.includes(session.id) && dayGroup(ages[session.id] ?? 0) === title),
    })),
  ].filter((group) => group.items.length);
  return (
    <section className="preview-chat-panel" aria-label="Conversations" inert={collapsed} aria-hidden={collapsed || undefined}>
      <Button className="ui-nav-row preview-new-chat" aria-label="New chat" disabled={loading} onClick={onNewChat}>
        <Plus size={16} aria-hidden="true" />
        <span>New chat</span>
      </Button>
      <Button className="ui-nav-row preview-agents-entry" aria-current={view === UI_VIEW.CONNECT ? 'page' : undefined} onClick={onConnect}>
        <PreviewAgentLogos />
        <span>Connect agents</span>
      </Button>
      <header className="preview-chat-panel-head">
        <h2 className="ui-sidebar-section-title">Chats</h2>
        <IconButton
          label={searching ? 'Close search' : 'Search conversations'}
          aria-pressed={searching}
          onClick={() => {
            setSearching(!searching);
            setSearch('');
          }}
        >
          {searching ? <X size={14} aria-hidden="true" /> : <MagnifyingGlass size={14} aria-hidden="true" />}
        </IconButton>
        <Dropdown
          label={'Filter conversations: ' + filter}
          iconOnly
          className="preview-chat-filter"
          trigger={<FunnelSimple size={14} weight={filter === 'All chats' ? 'regular' : 'fill'} aria-hidden="true" />}
        >
          {(close) =>
            CHAT_FILTERS.map((option) => (
              <MenuItem
                key={option}
                role="menuitemradio"
                checked={option === filter}
                label={option}
                trailing={option === filter ? <Check size={14} aria-hidden="true" /> : undefined}
                onClick={() => {
                  setFilter(option);
                  close();
                }}
              />
            ))
          }
        </Dropdown>
      </header>
      {searching && (
        <SearchField label="Search conversations" placeholder="Search conversations" value={search} onValueChange={setSearch} autoFocus />
      )}
      <div className="preview-chat-groups">
        {groups.map((group) => (
          <section key={group.title} aria-label={group.title}>
            <h3 className="preview-chat-group-title">{group.title}</h3>
            {group.items.map((session) => {
              const status = session.run || session.paypalRun ? 'running' : state.unread.includes(session.id) ? 'unread' : null;
              const pinned = state.pinned.includes(session.id);
              return (
                <div key={session.id} className="preview-chat-row">
                  <Button
                    className="ui-nav-row"
                    disabled={loading}
                    aria-current={view === UI_VIEW.CHAT && activeId === session.id ? 'page' : undefined}
                    onClick={() => onOpenChat(session.id)}
                  >
                    <span>{conversationTitle(session, state.titles)}</span>
                    {status && <PreviewChatState state={status} />}
                  </Button>
                  <IconButton
                    className="preview-chat-pin"
                    label={pinned ? 'Unpin conversation' : 'Pin conversation'}
                    aria-pressed={pinned}
                    onClick={() => togglePin(session.id)}
                  >
                    <PushPin size={14} weight={pinned ? 'fill' : 'regular'} aria-hidden="true" />
                  </IconButton>
                </div>
              );
            })}
          </section>
        ))}
        {!groups.length && (
          <p className="ui-help-text">
            {loading ? 'Loading conversations…' : query || filter !== 'All chats' ? 'No conversations found.' : 'Your conversations will appear here.'}
          </p>
        )}
      </div>
    </section>
  );
}

const CONVERSATION_DIALOG = { RENAME: 'rename', DELETE: 'delete' } as const;
type ConversationDialog = (typeof CONVERSATION_DIALOG)[keyof typeof CONVERSATION_DIALOG];

/** Title bar menu for the open conversation: pin, rename, copy as Markdown, delete (preview-only state). */
export function PreviewConversationMenu({ chat }: { chat: ChatController }) {
  const { sessions, activeId } = useSyncExternalStore(chat.subscribe, chat.getSnapshot);
  const state = usePreviewConversations();
  const [dialog, setDialog] = useState<ConversationDialog | null>(null);
  const [name, setName] = useState('');
  const session = sessions.find((item) => item.id === activeId);
  if (!session?.messages.length) return null;
  const title = conversationTitle(session, state.titles);
  const pinned = state.pinned.includes(session.id);
  const remove = () => {
    updateConversations((current) => ({ removed: [...current.removed, session.id], pinned: without(current.pinned, session.id) }));
    const next = sessions
      .filter((item) => item.id !== session.id && item.messages.length && !state.removed.includes(item.id))
      .at(-1);
    if (next) chat.openChat(next.id);
    else chat.newChat(crypto.randomUUID());
    setDialog(null);
  };
  return (
    <>
      <Dropdown label="Conversation actions" iconOnly className="preview-conversation-menu" trigger={<DotsThree size={16} weight="bold" aria-hidden="true" />}>
        {(close) => (
          <>
            <MenuItem label={pinned ? 'Unpin' : 'Pin'} leading={<PushPin size={14} aria-hidden="true" />} onClick={() => { togglePin(session.id); close(); }} />
            <MenuItem label="Rename…" leading={<PencilSimple size={14} aria-hidden="true" />} onClick={() => { setName(title); setDialog(CONVERSATION_DIALOG.RENAME); close(); }} />
            <MenuItem
              label="Copy as Markdown"
              leading={<Copy size={14} aria-hidden="true" />}
              onClick={() => {
                const text = '# ' + title + '\n\n' + session.messages.map((message) => (message.role === 'user' ? '**You:** ' : '**Gyblos:** ') + message.text).join('\n\n');
                void navigator.clipboard.writeText(text).catch(() => undefined);
                close();
              }}
            />
            <MenuItem label="Delete…" leading={<Trash size={14} aria-hidden="true" />} onClick={() => { setDialog(CONVERSATION_DIALOG.DELETE); close(); }} />
          </>
        )}
      </Dropdown>
      <MotionPresence>
        {dialog === CONVERSATION_DIALOG.RENAME && (
          <Modal title="Rename conversation" size="sm" close={() => setDialog(null)}>
            <form
              className="ui-form"
              onSubmit={(event) => {
                event.preventDefault();
                const next = name.trim();
                if (next) updateConversations((current) => ({ titles: { ...current.titles, [session.id]: next } }));
                setDialog(null);
              }}
            >
              <FormField label="Name" htmlFor="preview-conversation-name">
                <FormInput id="preview-conversation-name" value={name} maxLength={80} autoFocus onChange={(event) => setName(event.target.value)} />
              </FormField>
              <FormActions>
                <Button type="button" onClick={() => setDialog(null)}>Cancel</Button>
                <Button type="submit" variant={BUTTON_VARIANT.PRIMARY} disabled={!name.trim()}>Save</Button>
              </FormActions>
            </form>
          </Modal>
        )}
        {dialog === CONVERSATION_DIALOG.DELETE && (
          <Modal title="Delete conversation?" description={'"' + title + '" will be removed from this device.'} size="sm" close={() => setDialog(null)}>
            <FormActions>
              <Button onClick={() => setDialog(null)}>Cancel</Button>
              <Button variant={BUTTON_VARIANT.DANGER} onClick={remove}>Delete</Button>
            </FormActions>
          </Modal>
        )}
      </MotionPresence>
    </>
  );
}

/** Side panel with the open conversation's model, seller, tokens, spend and latency. */
export function PreviewChatDetails({ chat, onClose }: { chat: ChatController; onClose(): void }) {
  const { sessions, activeId } = useSyncExternalStore(chat.subscribe, chat.getSnapshot);
  const session = sessions.find((item) => item.id === activeId);
  const answers = session?.messages.filter((message) => message.role !== 'user' && message.metrics) ?? [];
  const last = session?.messages.findLast((message) => message.role !== 'user');
  const sum = (pick: (metrics: NonNullable<(typeof answers)[number]['metrics']>) => number | null | undefined) =>
    answers.reduce((total, message) => total + (message.metrics ? pick(message.metrics) ?? 0 : 0), 0);
  const latency = answers.length ? Math.round(sum((metrics) => metrics.responseMs) / answers.length) : null;
  const spend = sum((metrics) => Number(metrics.cost?.amount ?? 0));
  return (
    <aside className="ui-context-panel preview-chat-details" aria-label="Conversation details">
      <header className="ui-context-heading">
        <h2>Details</h2>
        <IconButton label="Close details" onClick={onClose}>
          <X size={16} aria-hidden="true" />
        </IconButton>
      </header>
      {!session?.messages.length ? (
        <p className="ui-help-text">Send a message to see its model, seller and cost.</p>
      ) : (
        <Facts compact>
          <Pair label="Model" value={last?.model.name ?? '—'} />
          <Pair label="Seller" value={last?.model.free ? 'Community seller · Free' : 'Chosen by Auto'} />
          <Pair label="Messages" value={String(session.messages.length)} />
          <Pair label="Tokens" value={sum((metrics) => metrics.inputTokens).toLocaleString() + ' in · ' + sum((metrics) => metrics.outputTokens).toLocaleString() + ' out'} />
          <Pair label="Spend" value={spend ? spend.toFixed(4) + ' USDC' : 'Free'} />
          <Pair label="Avg. response" value={latency === null ? '—' : (latency / 1000).toFixed(1) + ' s'} />
        </Facts>
      )}
    </aside>
  );
}
