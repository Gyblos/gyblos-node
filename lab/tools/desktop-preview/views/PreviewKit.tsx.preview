export function Tag({ tone = TONE.NEUTRAL, dot = false, pill = false, children }: { tone?: Tone; dot?: boolean; pill?: boolean; children: ReactNode }) {
  return (
    <span className="pk-tag" data-tone={tone} data-pill={pill || undefined}>
      {dot && <span className="pk-dot" aria-hidden="true" />}
      {children}
    </span>
  );
}

/** One-line notice with a tone: replacement, fallback or limit messages that must stay visible. */
export function Notice({ tone = TONE.WARNING, children }: { tone?: Tone; children: ReactNode }) {
  const Glyph = tone === TONE.WARNING || tone === TONE.DANGER ? Warning : Info;
  return (
    <p className="pk-notice" data-tone={tone} role="status">
      <Glyph size={15} weight="fill" aria-hidden="true" />
      <span>{children}</span>
    </p>
  );
}

/** On/off control for a global setting; the row beside it carries the label and help. */
export function Switch({ label, checked, onChange }: { label: string; checked: boolean; onChange(checked: boolean): void }) {
  return (
    <Button className="pk-switch" role="switch" aria-checked={checked} aria-label={label} onClick={() => onChange(!checked)}>
      <span className="pk-switch-thumb" aria-hidden="true" />
    </Button>
  );
}

/** Signed percentage; `lowerIsBetter` colors a decrease green (prices, latency) and an increase red. */
export function Delta({ percent, lowerIsBetter = false, suffix }: { percent: number; lowerIsBetter?: boolean; suffix?: string }) {
  const rounded = Math.round(percent);
  const good = lowerIsBetter ? rounded < 0 : rounded > 0;
  return (
    <span className="pk-delta" data-tone={rounded === 0 ? TONE.NEUTRAL : good ? TONE.SUCCESS : TONE.DANGER}>
      {(rounded > 0 ? '+' : rounded < 0 ? '−' : '') + Math.abs(rounded) + '%'}
      {suffix && <span className="pk-delta-suffix">{' ' + suffix}</span>}
    </span>
  );
}

/** "20% below median" against the median of the current offers for the same model. */
export function Savings({ price, median }: { price: number; median: number | null }) {
  if (median == null || !(median > 0) || price >= median) return null;
  const percent = Math.round(((median - price) / median) * 100);
  return (
    <span className="pk-delta" data-tone={TONE.SUCCESS} title={'Median of current offers: ' + usdPerMtok(median) + ' / 1M tokens'}>
      {percent}% below median
    </span>
  );
}

export type Segment = { label: string; value: number; tone: Tone };
export function SegmentedBar({ label, total, segments, format }: {
  label: string;
  total: number;
  segments: readonly Segment[];
  format(value: number): string;
}) {
  const used = segments.reduce((sum, segment) => sum + segment.value, 0);
  const scale = Math.max(total, used, 1);
  return (
    <div className="pk-segmented">
      <div className="pk-segmented-track" aria-hidden="true">
        {segments.map((segment) => (
          <span key={segment.label} data-tone={segment.tone} style={{ width: (segment.value / scale) * 100 + '%' }} />
        ))}
      </div>
      <ul className="pk-legend" aria-label={label}>
        {segments.map((segment) => (
          <li key={segment.label}>
            <span className="pk-dot" data-tone={segment.tone} aria-hidden="true" />
            {segment.label}
            <strong>{format(segment.value)}</strong>
          </li>
        ))}
      </ul>
    </div>
  );
}

export type FilterOption<T extends string> = { value: T; label: string; count: number };
export function FilterChips<T extends string>({ label, options, value, onChange }: {
  label: string;
  options: readonly FilterOption<T>[];
  value: T;
  onChange(value: T): void;
}) {
  const move = (event: KeyboardEvent<HTMLDivElement>) => {
    const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
    if (!step) return;
    event.preventDefault();
    const index = options.findIndex((option) => option.value === value);
    const next = options[(index + step + options.length) % options.length];
    if (!next) return;
    onChange(next.value);
    event.currentTarget.querySelector<HTMLButtonElement>('[data-value="' + next.value + '"]')?.focus();
  };
  return (
    <div className="pk-chips" role="radiogroup" aria-label={label} onKeyDown={move}>
      {options.map((option) => (
        <button
          key={option.value}
          type="button"
          role="radio"
          data-value={option.value}
          aria-checked={option.value === value}
          tabIndex={option.value === value ? 0 : -1}
          onClick={() => onChange(option.value)}
        >
          {option.label}
          <span className="pk-count">{option.count}</span>
        </button>
      ))}
    </div>
  );
}

/** The one code sample: language label, colored tokens and a copy action. `onCopy` returning false keeps "Copy". */
export function CodeBlock({ code, language, title, onCopy, copyDisabled = false }: {
  code: string;
  language: CodeLanguage;
  title?: string;
  onCopy?: () => Promise<unknown> | unknown;
  copyDisabled?: boolean;
}) {
  const [copied, setCopied] = useState(false);
  const tokens = useMemo(() => highlightCode(code, language), [code, language]);
  useEffect(() => {
    if (!copied) return;
    const timer = setTimeout(() => setCopied(false), 1600);
    return () => clearTimeout(timer);
  }, [copied]);
  useEffect(() => setCopied(false), [code]);
  return (
    <figure className="pk-code">
      <figcaption>
        <span className="pk-code-language">{codeLanguageLabel(language)}</span>
        {title && <span className="pk-code-title">{title}</span>}
        <button
          type="button"
          className="pk-code-copy"
          disabled={copyDisabled}
          aria-label={copied ? 'Copied' : 'Copy ' + (title ?? 'code')}
          onClick={() => {
            void Promise.resolve(onCopy ? onCopy() : navigator.clipboard.writeText(code))
              .then((result) => setCopied(onCopy ? result === true : true))
              .catch(() => setCopied(false));
          }}
        >
          {copied ? <Check size={14} aria-hidden="true" /> : <Copy size={14} aria-hidden="true" />}
          <span aria-hidden="true">{copied ? 'Copied' : 'Copy'}</span>
        </button>
      </figcaption>
      <pre tabIndex={0}>
        <code>
          {tokens.map((token, index) =>
            token.kind ? <span key={index} data-token={token.kind}>{token.text}</span> : token.text,
          )}
        </code>
      </pre>
    </figure>
  );
}
const FENCE_LANGUAGE: Record<string, CodeLanguage> = {
  sh: CODE_LANGUAGE.SHELL, bash: CODE_LANGUAGE.SHELL, zsh: CODE_LANGUAGE.SHELL, shell: CODE_LANGUAGE.SHELL, console: CODE_LANGUAGE.SHELL,
  json: CODE_LANGUAGE.JSON, toml: CODE_LANGUAGE.TOML,
  ts: CODE_LANGUAGE.TS, tsx: CODE_LANGUAGE.TS, typescript: CODE_LANGUAGE.TS, js: CODE_LANGUAGE.TS, javascript: CODE_LANGUAGE.TS,
};
/** Language of a Markdown fence such as "```json"; unlabeled fences stay plain text. */
export function fenceLanguage(fence: string): CodeLanguage {
  return FENCE_LANGUAGE[/^```\s*([\w-]*)/.exec(fence)?.[1]?.toLowerCase() ?? ''] ?? CODE_LANGUAGE.TEXT;
}
/** Coding-tool configuration format: Codex uses TOML, Claude Code shell variables, the others JSON. */
export function agentCodeLanguage(tool: AgentTool): CodeLanguage {
  if (tool === AGENT_TOOLS.CODEX) return CODE_LANGUAGE.TOML;
  if (tool === AGENT_TOOLS.CLAUDE_CODE) return CODE_LANGUAGE.SHELL;
  return CODE_LANGUAGE.JSON;
}

export type DetailItem = { label: string; value: ReactNode; note?: string };
/** The one detail-dialog summary: status line, headline numbers, then a key/value list. */
export function DetailSummary({ status, meta, totals, rows = [] }: {
  status?: { label: string; tone: Tone };
  meta?: string;
  totals: DetailItem[];
  rows?: DetailItem[];
}) {
  return (
    <div className="pk-detail">
      {(status || meta) && (
        <div className="preview-detail-head">
          {status && <Tag tone={status.tone} dot>{status.label}</Tag>}
          {meta && <span className="ui-help-text">{meta}</span>}
        </div>
      )}
      <dl className="preview-detail-totals">
        {totals.map((item) => (
          <div key={item.label}>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
      {rows.length > 0 && (
        <dl className="preview-detail-list">
          {rows.map((item) => (
            <div key={item.label}>
              <dt>{item.label}</dt>
              <dd>
                <span>{item.value}</span>
                {item.note && <small>{item.note}</small>}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  );
}

export function Panel({ title, children }: { title: string; children: ReactNode }) {
  return (
    <section className="preview-panel" aria-label={title}>
      <h3>{title}</h3>
      {children}
    </section>
  );
}

