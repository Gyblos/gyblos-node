const RAIL = [
  { view: UI_VIEW.CHAT, label: 'Chat', icon: <SidebarActionIcon kind={SIDEBAR_ACTION.CHAT} /> },
  { view: UI_VIEW.MODELS, label: 'Models', icon: <SidebarIcon name={UI_VIEW.MODELS} /> },
  { view: UI_VIEW.CONNECT, label: 'Connections', icon: <SidebarActionIcon kind={SIDEBAR_ACTION.LINK} /> },
  { view: UI_VIEW.PAYMENTS, label: 'Usage & payments', icon: <SidebarActionIcon kind={SIDEBAR_ACTION.WALLET} /> },
] as const;

export function BuyerSidebar(props: Props) {
  const current = props.view === UI_VIEW.ACTIVITY ? UI_VIEW.PAYMENTS : props.view;
  const rail = (view: View, label: string, icon: ReactNode) => (
    <Button
      key={view}
      className="ui-icon-button preview-rail-item"
      aria-label={label}
      title={label}
      aria-current={current === view ? 'page' : undefined}
      onClick={() => props.navigate(view)}
    >
      {icon}
    </Button>
  );
  return (
    <aside id="app-sidebar" className="sidebar buyer-sidebar">
      <nav aria-label="Main navigation" className="preview-rail">
        {RAIL.map((item) => rail(item.view, item.label, item.icon))}
        <span className="preview-rail-spacer" />
        {rail(UI_VIEW.SETTINGS, 'Settings', <SidebarActionIcon kind={SIDEBAR_ACTION.SETTINGS} />)}
      </nav>
      <PreviewConversationPanel
        chat={props.chat}
        view={props.view}
        collapsed={props.collapsed}
        loading={props.storageState === CHAT_STORAGE_STATE.LOADING}
        onNewChat={props.onNewChat}
        onOpenChat={props.onOpenChat}
        onConnect={() => props.navigate(UI_VIEW.CONNECT)}
      />
    </aside>
  );
}
