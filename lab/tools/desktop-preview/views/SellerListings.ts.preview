
export function announcedModels(catalog: NetworkCatalog, now: number): CatalogModel[] {
  return groupedModels(catalog, now).flatMap((model) => {
    if (model.free) return [model];
    return [
      { ...model, id: model.id + '-cedar', family: 'Seller 4b91…1f32 · ' + model.family },
      { ...model, id: model.id + '-spruce', family: 'Seller 83ce…a019 · ' + model.family, input: 0.08, output: 0.24 },
    ];
  });
}
