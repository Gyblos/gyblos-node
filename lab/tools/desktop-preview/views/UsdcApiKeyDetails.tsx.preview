// Connection fields and immutable key budget use shared buyer primitives; secrets copy only in the host.
import { useState } from 'react';

import type {
  BuyerApiKeySummary,
  BuyerKeyScope,
} from '@gyblos/protocol/buyer-api-keys';

import { usdcApiAmount as amount, USDC_API_ACTION } from '../usdc-api-model';
import { BuyerAgentSetup } from './BuyerAgentSetup';
import { BUTTON_VARIANT, UI_VIEW } from './constants';
import { CopyField, FormActions } from './Form';
import { Facts, Pair } from './Management';
import { Modal } from './Modal';
import { PREVIEW_COPY, showPreviewToast, usePreviewSetting } from './PreviewKit';
import { Badge, Button } from './UI';
import type { useUsdcApiKeys } from './useUsdcApiKeys';

type Controller = ReturnType<typeof useUsdcApiKeys>;
// Preview-only: keys follow the account-wide free-model fallback in Settings; there is no per-key choice.
export function KeyFallback() {
  const fallback = usePreviewSetting('freeFallback');
  return (
    <div className="preview-key-fallback">
      <span>
        <strong>Out of funds or at its limit</strong>
        <small>{fallback ? 'Answers with a similar free model and says so.' : PREVIEW_COPY.keyOutOfFunds + ' ' + PREVIEW_COPY.keyAtLimit}</small>
      </span>
      <Button onClick={() => window.previewNavigate?.(UI_VIEW.SETTINGS)}>Open Settings</Button>
    </div>
  );
}
function KeyUsage({
  keyStatus: key,
  scope,
  known,
}: {
  keyStatus: BuyerApiKeySummary;
  scope: BuyerKeyScope;
  known: boolean;
}) {
  if (!known) return <p role="status">Recorded amounts need review.</p>;
  const spent = BigInt(key.spentAtomic);
  const reserved = BigInt(key.reservedAtomic);
  const limit = BigInt(key.limitAtomic);
  return (
    <div className="preview-key-budget">
      <div>
        <span>
          <strong>{amount(key.spentAtomic, scope)}</strong> used of{' '}
          {amount(key.limitAtomic, scope)}
        </span>
        <span>{amount(String(limit - spent - reserved), scope)} available</span>
      </div>
      {limit > 0n && (
        <progress
          aria-label="Budget consumed"
          max={100}
          value={Number((spent * 10000n) / limit) / 100}
        />
      )}
      {(reserved > 0n || BigInt(key.approvedAtomic) > 0n) && (
        <small>Usage pending settlement · See connection context</small>
      )}
    </div>
  );
}
export function RevokeConfirmation({
  id,
  close,
  run,
}: {
  id: string;
  close: () => void;
  run: Controller['run'];
}) {
  return (
    <Modal title="Revoke API key?" size="sm" close={close}>
      <p>
        Stops new requests from every tool using this key. An inference already
        sent can still count. Its consumption and pending reservations stay
        recorded.
      </p>
      <FormActions>
        <Button onClick={close}>Keep key</Button>
        <Button
          className="preview-destructive"
          onClick={() => {
            close();
            void run({ action: USDC_API_ACTION.REVOKE, id }).then((result) => {
              if (result && !result.error) showPreviewToast('API key revoked');
            });
          }}
        >
          Revoke key
        </Button>
      </FormActions>
    </Modal>
  );
}
function KeyActions({
  api,
  id,
  known,
  revoked,
}: {
  api: Controller;
  id: string;
  known: boolean;
  revoked: boolean;
}) {
  const { busy, run } = api;
  return (
    <FormActions align="start">
      <BuyerAgentSetup api={api} id={id} disabled={busy || !known || revoked} />
      <Button
        disabled={busy || !known || revoked}
        onClick={() => {
          void run({ action: USDC_API_ACTION.COPY_EXAMPLE, id });
        }}
      >
        Copy API example
      </Button>
    </FormActions>
  );
}

export function UsdcApiKeyDetails({
  api,
  id,
}: {
  api: Controller;
  id: string;
}) {
  const { state, busy, run } = api;

  const scope = state.snapshot?.scope;
  const key = state.snapshot?.keys.find((key) => key.id === id);
  if (!key || !state.url || !scope) return null;
  const known = !state.error && !state.snapshot?.blocked;
  const available = known && !key.revoked && state.copyable.includes(key.id);
  return (
    <section className="ui-section" aria-label="USDC API connection">
      <span className="ui-help-text">Selected API key</span>
      <div className="ui-section-title">
        <h2>{key.name}</h2>
        <Badge>
          {key.revoked
            ? 'Revoked'
            : state.snapshot?.blocked
              ? 'Needs review'
              : key.spentAtomic === key.limitAtomic
                ? 'Paid limit reached'
                : 'Active'}
        </Badge>
      </div>
      <CopyField
        id="usdc-tool-key"
        label="API key"
        secret
        value="Key saved in your tool"
        actionLabel="Copy API key"
        disabled={busy || !available}
        onCopy={() => {
          void run({ action: USDC_API_ACTION.COPY_KEY, id });
        }}
      />
      {!state.copyable.includes(key.id) && !key.revoked && (
        <p className="ui-help-text">
          The secret is available only in the app session that created it. A key
          already saved in your tool keeps its original limit after restart.
        </p>
      )}
      <CopyField
        id="usdc-tool-url"
        label="Base URL"
        value={state.url}
        actionLabel="Copy Base URL"
        disabled={busy || !known || key.revoked}
        onCopy={() => {
          void run({ action: USDC_API_ACTION.COPY_URL, id });
        }}
      />

      <KeyActions api={api} id={id} known={known} revoked={key.revoked} />
      <KeyUsage keyStatus={key} scope={scope} known={known} />
    </section>
  );
}
