import { CheckCircle, Info, Warning, WarningCircle } from '@phosphor-icons/react';
import { useState } from 'react';

import { PREVIEW_NETWORK } from '../../../../lab/tools/desktop-preview/constants';
import { LOCAL_NODE_STATE, type LocalNodeState } from '../node-status';
import { WALLET_STATUS } from '../wallet/model';
import { LOCAL_NODE_LABELS } from './constants';
import { Modal } from './Modal';
import { MotionPresence } from './Motion';
import { NetworkStatus } from './NetworkStatus';
import { openPreviewUpdate, TONE, usePreviewNetwork, usePreviewNewerVersion, type Tone } from './PreviewKit';
import { Button } from './UI';
import { useDesktopWallet } from './WalletState';

type StatusCheck = { label: string; value: string; tone: Tone; summary?: string; action?: { label: string; run(): void } };
const ISSUE: readonly Tone[] = [TONE.WARNING, TONE.DANGER];
const GLYPH = { [TONE.SUCCESS]: CheckCircle, [TONE.WARNING]: Warning, [TONE.DANGER]: WarningCircle, [TONE.INFO]: Info, [TONE.NEUTRAL]: Info };

function nodeTone(state: LocalNodeState): Tone {
  if (state === LOCAL_NODE_STATE.READY) return TONE.SUCCESS;
  if (state === LOCAL_NODE_STATE.ERROR || state === LOCAL_NODE_STATE.STOPPED) return TONE.DANGER;
  return TONE.INFO;
}

export function SystemStatus({ state, onRetry, onPayments }: { state: LocalNodeState; onRetry(): void; onPayments(): void }) {
  const [open, setOpen] = useState(() => new URLSearchParams(location.search).get('review') === 'system-status');
  const wallet = useDesktopWallet();
  const network = usePreviewNetwork();
  const update = usePreviewNewerVersion();
  const manage = { label: 'Manage', run: () => { setOpen(false); onPayments(); } };
  const checks: StatusCheck[] = [
    wallet.status === WALLET_STATUS.READY
      ? { label: 'Wallet', value: 'Ready', tone: TONE.SUCCESS }
      : wallet.status === WALLET_STATUS.LOCKED
        ? { label: 'Wallet', value: 'Locked · free chat still works', tone: TONE.NEUTRAL, action: manage }
        : wallet.status === WALLET_STATUS.LOADING
          ? { label: 'Wallet', value: 'Loading', tone: TONE.INFO }
          : wallet.status === WALLET_STATUS.RECOVERY_REQUIRED
            ? { label: 'Wallet', value: 'Recovery required', tone: TONE.DANGER, summary: 'Wallet recovery required', action: manage }
            : { label: 'Wallet', value: 'Unavailable', tone: TONE.DANGER, summary: 'Wallet unavailable', action: manage },
  ];
  if (wallet.status === WALLET_STATUS.READY)
    checks.push(
      wallet.backupVerified
        ? { label: 'Recovery backup', value: 'Verified', tone: TONE.SUCCESS }
        : { label: 'Recovery backup', value: 'Not verified yet', tone: TONE.WARNING, summary: 'Backup needed', action: { ...manage, label: 'Back up' } },
    );
  checks.push(
    update
      ? { label: 'Desktop app', value: 'Gyblos ' + update + ' is available', tone: TONE.INFO, action: { label: 'View update', run: () => { setOpen(false); openPreviewUpdate(); } } }
      : { label: 'Desktop app', value: 'Up to date', tone: TONE.SUCCESS },
    { label: 'Network', value: network === PREVIEW_NETWORK.TESTNET ? 'Testnet · test funds only' : PREVIEW_NETWORK.MAINNET, tone: network === PREVIEW_NETWORK.TESTNET ? TONE.INFO : TONE.SUCCESS },
  );
  const nodeIssue = nodeTone(state) === TONE.DANGER;
  const issues = [
    ...(nodeIssue ? [{ tone: TONE.DANGER, summary: LOCAL_NODE_LABELS[state] }] : []),
    ...checks.filter((check) => ISSUE.includes(check.tone)),
  ];
  const tone = issues.some((issue) => issue.tone === TONE.DANGER)
    ? TONE.DANGER
    : issues.length
      ? TONE.WARNING
      : state === LOCAL_NODE_STATE.READY && wallet.status !== WALLET_STATUS.LOADING
        ? TONE.SUCCESS
        : TONE.INFO;
  const summary = issues.length > 1
    ? issues.length + ' items need attention'
    : (issues[0]?.summary ??
      (state !== LOCAL_NODE_STATE.READY
        ? LOCAL_NODE_LABELS[state]
        : wallet.status === WALLET_STATUS.LOADING
          ? 'Loading wallet'
          : 'All systems ready'));
  return (
    <>
      <Button
        className="preview-status-trigger"
        data-tone={tone}
        aria-label={'System status: ' + summary}
        aria-haspopup="dialog"
        onClick={() => setOpen(true)}
      >
        <span className="pk-dot" aria-hidden="true" />
        <span>{summary}</span>
      </Button>
      <MotionPresence>
        {open && (
          <Modal title="System status" close={() => setOpen(false)}>
            <div className="ui-section">
              <section className="ui-status-item">
                <h3>Local node</h3>
                <NetworkStatus state={state} onRetry={onRetry} />
              </section>
              <ul className="preview-status-list" aria-label="Checks">
                {checks.map((check) => {
                  const Glyph = GLYPH[check.tone];
                  return (
                    <li key={check.label} className="preview-status-row" data-tone={check.tone}>
                      <Glyph size={18} weight="fill" aria-hidden="true" />
                      <span className="preview-status-copy">
                        <strong>{check.label}</strong>
                        <small>{check.value}</small>
                      </span>
                      {check.action && <Button onClick={check.action.run}>{check.action.label}</Button>}
                    </li>
                  );
                })}
              </ul>
              <p className="ui-help-text">Sellers are checked when you send a message.</p>
            </div>
          </Modal>
        )}
      </MotionPresence>
    </>
  );
}
