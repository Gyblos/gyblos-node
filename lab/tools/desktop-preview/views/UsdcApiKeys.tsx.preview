import { CaretDown, Check, Copy, Info, Key, LinkSimple, PlugsConnected, Plus } from '@phosphor-icons/react';
// Buyer-owned USDC key management uses shared forms and financial facts; no wallet keys enter the view.
import { useEffect, useState, type ReactNode } from 'react';

import { DEVNET_USDC } from '@gyblos/config/network';
import {
  AGENT_SETUP,
  AGENT_TOOLS,
  type AgentTool,
} from '@gyblos/node/agent-setup-constants';
import {
  BUYER_API_KEYS,
  type BuyerKeyScope,
} from '@gyblos/protocol/buyer-api-keys';

import {
  usdcApiAmount as amount,
  USDC_API,
  USDC_API_ACTION,
} from '../usdc-api-model';
import { x402Asset, x402BudgetInput } from '../x402-model';
import { BUTTON_VARIANT } from './constants';
import { DataCell, TableRow } from './DataTable';
import { CopyField, FormActions, FormField, FormInput } from './Form';
import { StatePanel } from './Management';
import { Modal } from './Modal';
import { MotionPresence } from './Motion';
import { ScrollTable } from './ScrollTable';
import { ServiceLogo } from './ServiceLogo';
import { Dropdown } from './Dropdown';
import { Badge, Button, IconButton, MenuItem } from './UI';
import { agentCodeLanguage, AmountEditor, CodeBlock, DetailSummary, Tag, TONE } from './PreviewKit';
import { KeyFallback, RevokeConfirmation } from './UsdcApiKeyDetails';
import { useUsdcApiKeys } from './useUsdcApiKeys';
import { WorkspaceLayout } from './WorkspaceLayout';

type Controller = ReturnType<typeof useUsdcApiKeys>;
function keyLimit(value: string, scope: BuyerKeyScope) {
  try {
    return x402BudgetInput(value, scope);
  } catch {
    return null;
  }
}
const KEY_PRESETS = [
  { value: '0', label: 'Free only' },
  { value: '0.01', label: '0.01' },
  { value: '0.05', label: '0.05' },
  { value: '0.1', label: '0.1' },
  { value: '1', label: '1' },
];
function NewKey({
  create,
  disabled,
  scope,
}: {
  scope: BuyerKeyScope;
  create: (name: string, limit: string) => void;
  disabled: boolean;
}) {
  const [name, setName] = useState('');
  const [limit, setLimit] = useState<string>(
    scope.mint === DEVNET_USDC ? USDC_API.DEFAULT_LIMIT : '0',
  );
  const atomic = keyLimit(limit, scope);
  const valid =
    atomic !== null && !!name.trim() && name.length <= BUYER_API_KEYS.MAX_NAME;
  return (
    <section className="ui-section" aria-label="Create USDC API key">
      <div className="ui-form ui-form--limited">
        <FormField label="Name" htmlFor="usdc-key-name">
          <FormInput
            id="usdc-key-name"
            value={name}
            maxLength={BUYER_API_KEYS.MAX_NAME}
            disabled={disabled}
            onChange={(event) => setName(event.target.value)}
          />
        </FormField>
        <AmountEditor
          id="usdc-key-limit"
          label="Limit for this key"
          unit={x402Asset(scope)}
          value={limit}
          onChange={setLimit}
          disabled={disabled}
          presets={KEY_PRESETS}
          parse={(value) => {
            const parsed = keyLimit(value, scope);
            return parsed === null ? null : BigInt(parsed);
          }}
          format={(value) => amount(String(value), scope).split(' ')[0] ?? ''}
          step={BigInt(keyLimit('0.01', scope) ?? '1')}
          error={atomic === null ? 'Enter an amount with up to 6 decimals.' : ''}
          help="Total for this key, inside your spending limit. No automatic reset. Zero allows free models only."
        />
        <FormActions align="start">
          <Button
            variant={BUTTON_VARIANT.PRIMARY}
            disabled={disabled || !valid}
            onClick={() => {
              if (valid && atomic !== null) create(name.trim(), atomic);
            }}
          >
            Create API key
          </Button>
        </FormActions>
      </div>
    </section>
  );
}
function UsdcKeyContext({
  onPayments,
  scope,
}: {
  onPayments: () => void;
  scope: BuyerKeyScope | undefined;
}) {
  return (
    <>
      <section className="ui-context-section">
        <h3>Payment method</h3>
        <strong>{scope ? x402Asset(scope) : 'USDC'}</strong>
        <p className="ui-help-text">
          Key usage counts toward your spending limit. Each key can also have its own limit.
        </p>
        <Button onClick={onPayments}>Spending limits</Button>
      </section>
      <section className="ui-context-section">
        <h3>Access</h3>
        <p className="ui-help-text">
          This computer · Keep Gyblos open. The key permission and consumption
          survive a restart.
        </p>
      </section>
    </>
  );
}
const toolNames = {
  [AGENT_TOOLS.OPENCODE]: 'OpenCode',
  [AGENT_TOOLS.CODEX]: 'Codex',
  [AGENT_TOOLS.CLAUDE_CODE]: 'Claude Code',
  [AGENT_TOOLS.PI]: 'Pi',
  other: 'Other tools',
};
const toolFiles = {
  [AGENT_TOOLS.OPENCODE]: AGENT_SETUP.files.opencode,
  [AGENT_TOOLS.CODEX]: AGENT_SETUP.files.codex,
  [AGENT_TOOLS.CLAUDE_CODE]: 'Terminal environment',
  [AGENT_TOOLS.PI]: AGENT_SETUP.files.pi,
};
type ToolChoice = AgentTool | 'other';
const TOOL_CHOICES = [
  AGENT_TOOLS.OPENCODE,
  AGENT_TOOLS.CLAUDE_CODE,
  AGENT_TOOLS.CODEX,
  AGENT_TOOLS.PI,
  'other',
] as const;
type KeyView = 'list' | 'detail' | 'revoke' | 'new';
// Synthetic setup state: a tool counts as configured once its configuration was copied in this preview.
export function UsdcApiKeys({
  onPayments,
  contextOpen,
  onCloseContext,
}: {
  onPayments: () => void;
  contextOpen: boolean;
  onCloseContext: () => void;
}) {
  const { state, run, busy } = useUsdcApiKeys();
  const snapshot = state.snapshot;
  const [view, setView] = useState<KeyView>('list');
  const [id, setId] = useState('');
  const [guideId, setGuideId] = useState('');
  const [tool, setTool] = useState<ToolChoice>(AGENT_TOOLS.OPENCODE);
  const [configured, setConfigured] = useState<ReadonlySet<ToolChoice>>(
    () => new Set(),
  );
  const [keyCopied, setKeyCopied] = useState(false);
  const key = snapshot?.keys.find((item) => item.id === id);
  const active = snapshot?.keys.filter((item) => !item.revoked) ?? [];
  const guideKey = active.find((item) => item.id === guideId) ?? active[0];
  const locked = busy || !!state.error || !!snapshot?.blocked;
  const ready = !!snapshot;
  useEffect(() => {
    if (ready && guideKey && tool !== 'other')
      void run({ action: USDC_API_ACTION.PREVIEW_AGENT, id: guideKey.id, tool });
  }, [ready, guideKey?.id, tool]);
  useEffect(() => setKeyCopied(false), [guideKey?.id, tool]);
  const go = (next: KeyView, keyId: string) => {
    setId(keyId);
    setView(next);
  };
  const markConfigured = (choice: ToolChoice) =>
    setConfigured((current) => new Set(current).add(choice));
  const choose = (keyId: string) => {
    setGuideId(keyId);
    setView('list');
    const guide = document.getElementById('preview-tool-guide');
    guide?.scrollIntoView({ block: 'nearest' });
    guide?.focus({ preventScroll: true });
  };
  const close = () => setView('list');
  const secretField = (
    item: NonNullable<typeof key>,
    fieldId: string,
    onCopied?: () => void,
  ) => (
    <CopyField
      label="API key"
      id={fieldId}
      secret
      value="Preview key"
      actionLabel="Copy API key"
      disabled={locked || item.revoked || !state.copyable.includes(item.id)}
      onCopy={() =>
        void run({ action: USDC_API_ACTION.COPY_KEY, id: item.id }).then(
          (result) => {
            if (!result?.error) onCopied?.();
          },
        )
      }
    />
  );
  const newDisabled =
    locked || (snapshot?.keys.length ?? 0) >= BUYER_API_KEYS.MAX_KEYS;
  const newButton = snapshot?.keys.length ? (
    <IconButton
      label="New API key"
      disabled={newDisabled}
      onClick={() => setView('new')}
    >
      <Plus size={18} />
    </IconButton>
  ) : (
    <Button
      variant={BUTTON_VARIANT.PRIMARY}
      disabled={newDisabled}
      onClick={() => setView('new')}
    >
      <Plus size={16} />
      Create your first API key
    </Button>
  );
  const done = (value: boolean, icon: ReactNode) => (
    <span aria-hidden="true">
      {value ? <Check size={13} weight="bold" /> : icon}
    </span>
  );
  return (
    <WorkspaceLayout
      context={
        <UsdcKeyContext onPayments={onPayments} scope={snapshot?.scope} />
      }
      contextOpen={contextOpen}
      onCloseContext={onCloseContext}
    >
      <div className="ui-connection-page">
        {!snapshot ? (
          <StatePanel
            title="Connect your USDC buyer"
            description="Start the local buyer to create API keys."
            action={<Button onClick={onPayments}>Open Usage &amp; payments</Button>}
          />
        ) : (
          <>
            {snapshot.blocked && (
              <StatePanel
                title="Spending needs review"
                description="Resolve the pending operation to use your keys."
                action={<Button onClick={onPayments}>Review payments</Button>}
              />
            )}
            <section className="ui-section" aria-labelledby="preview-tools-heading">
              <div className="preview-section-intro">
                <h2 id="preview-tools-heading">Connect a coding tool</h2>
                <p className="ui-help-text">
                  Your tool sends requests to Gyblos on this computer and pays sellers in USDC, inside the key limit.
                </p>
              </div>
              <div className="preview-tool-grid" role="group" aria-label="Choose a tool">
                {TOOL_CHOICES.map((choice) => (
                  <button
                    type="button"
                    key={choice}
                    className="preview-tool-card"
                    aria-pressed={tool === choice}
                    onClick={() => setTool(choice)}
                  >
                    <span className="preview-tool-logo">
                      <ServiceLogo service={toolNames[choice]} />
                    </span>
                    <strong>{toolNames[choice]}</strong>
                    <Tag
                      tone={configured.has(choice) ? TONE.SUCCESS : TONE.NEUTRAL}
                      dot={configured.has(choice)}
                    >
                      {configured.has(choice) ? 'Configured' : 'Not set up'}
                    </Tag>
                  </button>
                ))}
              </div>
            </section>
            <section
              id="preview-tool-guide"
              className="preview-tool-guide"
              tabIndex={-1}
              aria-labelledby="preview-guide-heading"
            >
              <header>
                <span className="preview-tool-logo">
                  <ServiceLogo service={toolNames[tool]} />
                </span>
                <div>
                  <h2 id="preview-guide-heading">
                    {tool === 'other'
                      ? 'Connect another tool'
                      : 'Set up ' + toolNames[tool]}
                  </h2>
                  <small>
                    {tool === 'other'
                      ? 'Any tool that speaks OpenAI Chat Completions, Responses or Anthropic Messages.'
                      : 'Three steps. The key stays on this computer.'}
                  </small>
                </div>
              </header>
              <ol className="preview-steps" aria-label={'Steps to connect ' + toolNames[tool]}>
                <li data-done={!!guideKey}>
                  {done(!!guideKey, <Key size={14} />)}
                  <div>
                    <strong>Choose an API key</strong>
                    <small>Each key has its own USDC limit.</small>
                    {guideKey ? (
                      <div className="preview-guide-key">
                        <Dropdown
                          label={`API key: ${guideKey.name}`}
                          className="preview-guide-key-trigger"
                          trigger={
                            <>
                              <Key size={14} aria-hidden="true" />
                              <span>{guideKey.name}</span>
                              <CaretDown size={12} aria-hidden="true" />
                            </>
                          }
                        >
                          {(close) =>
                            active.map((item) => (
                              <MenuItem
                                key={item.id}
                                role="menuitemradio"
                                checked={item.id === guideKey.id}
                                label={item.name}
                                detail={`${amount(item.spentAtomic, snapshot.scope).split(' ')[0]} / ${amount(item.limitAtomic, snapshot.scope)} used`}
                                trailing={
                                  item.id === guideKey.id ? (
                                    <Check size={14} aria-hidden="true" />
                                  ) : undefined
                                }
                                onClick={() => {
                                  setGuideId(item.id);
                                  close();
                                }}
                              />
                            ))
                          }
                        </Dropdown>
                        <span className="ui-help-text">
                          {amount(guideKey.spentAtomic, snapshot.scope).split(' ')[0]} /{' '}
                          {amount(guideKey.limitAtomic, snapshot.scope)} used
                        </span>
                      </div>
                    ) : (
                      <FormActions align="start">
                        <Button
                          variant={BUTTON_VARIANT.PRIMARY}
                          disabled={newDisabled}
                          onClick={() => setView('new')}
                        >
                          <Plus size={16} />
                          Create an API key
                        </Button>
                      </FormActions>
                    )}
                  </div>
                </li>
                <li data-done={keyCopied}>
                  {done(keyCopied, <Copy size={14} />)}
                  <div>
                    <strong>Copy the API key</strong>
                    <small>
                      {tool === 'other'
                        ? 'Paste it where your tool asks for an API key.'
                        : 'Set GYBLOS_API_KEY to it in the environment where ' + toolNames[tool] + ' runs.'}
                    </small>
                    {guideKey && secretField(guideKey, 'preview-guide-secret', () => setKeyCopied(true))}
                  </div>
                </li>
                <li data-done={configured.has(tool)}>
                  {done(configured.has(tool), <PlugsConnected size={14} />)}
                  <div>
                    <strong>
                      {tool === 'other' ? 'Copy the Base URL' : 'Add the configuration'}
                    </strong>
                    <small>
                      {tool === 'other'
                        ? 'Use it as the OpenAI or Anthropic base URL.'
                        : 'Paste it into the ' + toolNames[tool] + ' settings file.'}
                    </small>
                    {tool === 'other' ? (
                      <CopyField
                        label="Base URL"
                        id="preview-base-url"
                        value={state.url ?? ''}
                        actionLabel="Copy Base URL"
                        disabled={!state.url || busy}
                        onCopy={() =>
                          void run({ action: USDC_API_ACTION.COPY_URL }).then(
                            (result) => {
                              if (!result?.error) markConfigured('other');
                            },
                          )
                        }
                      />
                    ) : (
                      guideKey && (
                        <>
                          {state.setup && (
                            <CodeBlock
                              language={agentCodeLanguage(tool)}
                              title={toolFiles[tool]}
                              code={state.setup.text}
                              copyDisabled={locked}
                              onCopy={() =>
                                run({
                                  action: USDC_API_ACTION.COPY_AGENT,
                                  id: guideKey.id,
                                  tool,
                                }).then((result) => {
                                  const ok = result?.setup?.tool === tool && !result.error;
                                  if (ok) markConfigured(tool);
                                  return ok;
                                })
                              }
                            />
                          )}
                        </>
                      )
                    )}
                  </div>
                </li>
              </ol>
            </section>
            <section className="ui-section">
              <div className="ui-section-title">
                <h2>API keys</h2>
                {newButton}
              </div>
              {snapshot.keys.length > 0 && (
                  <ScrollTable
                    regionLabel="API key list"
                    resetKey="keys"
                    caption="API keys"
                    headings={['Name', 'State', 'Used / limit', 'Actions']}
                  >
                    {snapshot.keys.map((item) => (
                      <TableRow role="row" key={item.id}>
                        <DataCell label="Name">
                          <div className="preview-table-identity">
                            <strong>{item.name}</strong>
                          </div>
                        </DataCell>
                        <DataCell label="State">
                          <Tag tone={item.revoked ? TONE.NEUTRAL : TONE.SUCCESS} dot>{item.revoked ? 'Revoked' : 'Active'}</Tag>
                        </DataCell>
                        <DataCell label="Used / limit">
                          {
                            amount(item.spentAtomic, snapshot.scope).split(
                              ' ',
                            )[0]
                          }{' '}
                          / {amount(item.limitAtomic, snapshot.scope)}
                        </DataCell>
                        <DataCell label="Actions">
                          <div className="ui-inline-actions">
                            {!item.revoked && (
                              <IconButton
                                label={'Connect a tool with ' + item.name}
                                disabled={locked}
                                onClick={() => choose(item.id)}
                              >
                                <LinkSimple size={14} aria-hidden="true" />
                              </IconButton>
                            )}
                            <IconButton
                              label={'Details for ' + item.name}
                              onClick={() => go('detail', item.id)}
                            >
                              <Info size={14} aria-hidden="true" />
                            </IconButton>
                          </div>
                        </DataCell>
                      </TableRow>
                    ))}
                  </ScrollTable>
              )}
            </section>
            <MotionPresence>{view === 'new' && (
              <Modal title="Create an API key" close={close}>
                <NewKey
                  scope={snapshot.scope}
                  disabled={locked}
                  create={(name, limitAtomic) => {
                    void run({
                      action: USDC_API_ACTION.CREATE,
                      name,
                      limitAtomic,
                    }).then((result) => {
                      const created = result?.snapshot?.keys.find(
                        (k) => !snapshot.keys.some((old) => old.id === k.id),
                      );
                      if (created && !result?.error) go('detail', created.id);
                    });
                  }}
                />
              </Modal>
            )}</MotionPresence>
            <MotionPresence>{key && view === 'detail' && (
              <Modal title={key.name} close={close}>
                <DetailSummary
                  status={{ label: key.revoked ? 'Revoked' : 'Active', tone: key.revoked ? TONE.NEUTRAL : TONE.SUCCESS }}
                  meta="API key · USDC"
                  totals={[
                    { label: 'Used', value: amount(key.spentAtomic, snapshot.scope) },
                    { label: 'Limit', value: amount(key.limitAtomic, snapshot.scope) },
                    {
                      label: 'Available',
                      value: amount(
                        String(BigInt(key.limitAtomic) - BigInt(key.spentAtomic) - BigInt(key.reservedAtomic)),
                        snapshot.scope,
                      ),
                    },
                  ]}
                />
                {BigInt(key.limitAtomic) > 0n && (
                  <progress
                    className="preview-detail-progress"
                    aria-label="Limit used"
                    max={100}
                    value={Number(
                      (BigInt(key.spentAtomic) * 100n) / BigInt(key.limitAtomic),
                    )}
                  />
                )}
                {!key.revoked && (
                  <>
                    {secretField(key, 'preview-tool-secret')}
                    <KeyFallback />
                    <FormActions>
                      <Button
                        disabled={busy}
                        className="preview-destructive-ghost"
                        onClick={() => setView('revoke')}
                      >
                        Revoke key
                      </Button>
                      <Button
                        variant={BUTTON_VARIANT.PRIMARY}
                        disabled={locked}
                        onClick={() => choose(id)}
                      >
                        Connect a tool
                      </Button>
                    </FormActions>
                  </>
                )}
              </Modal>
            )}</MotionPresence>
            <MotionPresence>{key && view === 'revoke' && (
              <RevokeConfirmation id={id} run={run} close={close} />
            )}</MotionPresence>
          </>
        )}
        {state.error && <p role="alert">{state.error}</p>}
      </div>
    </WorkspaceLayout>
  );
}
