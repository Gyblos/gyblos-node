{
  "services": {
    "seller": {
      "image": "${GYBLOS_P2P_IMAGE}",
      "command": [
        "node",
        "--import",
        "tsx",
        "${GYBLOS_P2P_ACTOR_ENTRY}",
        "seller"
      ],
      "user": "${GYBLOS_P2P_USER}",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "pids_limit": "${GYBLOS_P2P_PIDS}",
      "mem_limit": "${GYBLOS_P2P_SELLER_MEMORY}",
      "cpus": "${GYBLOS_P2P_CPUS}",
      "volumes": ["seller-data:/app/.local"],
      "networks": {
        "home-a": {
          "ipv4_address": "${GYBLOS_P2P_SELLER_IP}"
        }
      },
      "environment": {
        "GYBLOS_RELAYS": null,
        "GYBLOS_RELAY_TOKEN": "${GYBLOS_RELAY_TOKEN:?GYBLOS_RELAY_TOKEN is required}",
        "GYBLOS_IROH_BIND": "${GYBLOS_P2P_SELLER_BIND}",
        "GYBLOS_EXPECTED_ROUTE": "",
        "GYBLOS_RPC_URL": "${GYBLOS_P2P_RPC}",
        "GYBLOS_P2P_RUN_ID": "${GYBLOS_P2P_RUN_ID}",
        "GYBLOS_IROH_EXTERNAL_ADDR": "${GYBLOS_P2P_SELLER_EXTERNAL}"
      },
      "depends_on": {
        "router-a": {
          "condition": "service_healthy"
        }
      }
    },
    "buyer": {
      "image": "${GYBLOS_P2P_IMAGE}",
      "command": [
        "node",
        "--import",
        "tsx",
        "${GYBLOS_P2P_ACTOR_ENTRY}",
        "buyer"
      ],
      "user": "${GYBLOS_P2P_USER}",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "pids_limit": "${GYBLOS_P2P_PIDS}",
      "mem_limit": "${GYBLOS_P2P_BUYER_MEMORY}",
      "cpus": "${GYBLOS_P2P_CPUS}",
      "volumes": ["buyer-data:/app/.local"],
      "networks": {
        "home-b": {
          "ipv4_address": "${GYBLOS_P2P_BUYER_IP}"
        }
      },
      "environment": {
        "GYBLOS_RELAYS": null,
        "GYBLOS_RELAY_TOKEN": "${GYBLOS_RELAY_TOKEN:?GYBLOS_RELAY_TOKEN is required}",
        "GYBLOS_IROH_BIND": "${GYBLOS_P2P_BUYER_BIND}",
        "GYBLOS_EXPECTED_ROUTE": "${GYBLOS_P2P_EXPECTED_ROUTE}",
        "GYBLOS_RPC_URL": "${GYBLOS_P2P_RPC}",
        "GYBLOS_P2P_RUN_ID": "${GYBLOS_P2P_RUN_ID}",
        "GYBLOS_IROH_EXTERNAL_ADDR": "${GYBLOS_P2P_BUYER_EXTERNAL}"
      },
      "depends_on": {
        "router-b": {
          "condition": "service_healthy"
        }
      }
    },
    "router-a": {
      "image": "${GYBLOS_P2P_ROUTER_IMAGE}",
      "user": "${GYBLOS_P2P_USER}",
      "read_only": true,
      "cap_drop": ["ALL"],
      "cap_add": ["NET_ADMIN"],
      "pids_limit": "${GYBLOS_P2P_ROUTER_PIDS}",
      "mem_limit": "${GYBLOS_P2P_ROUTER_MEMORY}",
      "tmpfs": ["/app/.local:uid=1000,gid=1000,mode=0700"],
      "sysctls": {
        "net.ipv4.ip_forward": "1",
        "net.ipv4.conf.all.rp_filter": "0"
      },
      "networks": {
        "home-a": {
          "ipv4_address": "${GYBLOS_P2P_ROUTER_A_HOME}"
        },
        "internet": {
          "ipv4_address": "${GYBLOS_P2P_ROUTER_A_WAN}",
          "gw_priority": 1
        }
      },
      "environment": {
        "HOME_ADDRESS": "${GYBLOS_P2P_ROUTER_A_HOME}/${GYBLOS_P2P_PREFIX_LENGTH}",
        "WAN_ADDRESS": "${GYBLOS_P2P_ROUTER_A_WAN}/${GYBLOS_P2P_PREFIX_LENGTH}",
        "HOME_GATEWAY": "${GYBLOS_P2P_GATEWAY_A}/${GYBLOS_P2P_PREFIX_LENGTH}",
        "HOME_CIDR": "${GYBLOS_P2P_HOME_A}",
        "OTHER_HOME_CIDR": "${GYBLOS_P2P_HOME_B}",
        "BLOCK_UDP": "${GYBLOS_P2P_BLOCK_UDP}"
      },
      "healthcheck": {
        "test": ["CMD", "test", "-f", "/app/.local/ready"],
        "interval": "1s",
        "timeout": "1s",
        "retries": 30
      }
    },
    "router-b": {
      "image": "${GYBLOS_P2P_ROUTER_IMAGE}",
      "user": "${GYBLOS_P2P_USER}",
      "read_only": true,
      "cap_drop": ["ALL"],
      "cap_add": ["NET_ADMIN"],
      "pids_limit": "${GYBLOS_P2P_ROUTER_PIDS}",
      "mem_limit": "${GYBLOS_P2P_ROUTER_MEMORY}",
      "tmpfs": ["/app/.local:uid=1000,gid=1000,mode=0700"],
      "sysctls": {
        "net.ipv4.ip_forward": "1",
        "net.ipv4.conf.all.rp_filter": "0"
      },
      "networks": {
        "home-b": {
          "ipv4_address": "${GYBLOS_P2P_ROUTER_B_HOME}"
        },
        "internet": {
          "ipv4_address": "${GYBLOS_P2P_ROUTER_B_WAN}",
          "gw_priority": 1
        }
      },
      "environment": {
        "HOME_ADDRESS": "${GYBLOS_P2P_ROUTER_B_HOME}/${GYBLOS_P2P_PREFIX_LENGTH}",
        "WAN_ADDRESS": "${GYBLOS_P2P_ROUTER_B_WAN}/${GYBLOS_P2P_PREFIX_LENGTH}",
        "HOME_GATEWAY": "${GYBLOS_P2P_GATEWAY_B}/${GYBLOS_P2P_PREFIX_LENGTH}",
        "HOME_CIDR": "${GYBLOS_P2P_HOME_B}",
        "OTHER_HOME_CIDR": "${GYBLOS_P2P_HOME_A}",
        "BLOCK_UDP": "0"
      },
      "healthcheck": {
        "test": ["CMD", "test", "-f", "/app/.local/ready"],
        "interval": "1s",
        "timeout": "1s",
        "retries": 30
      }
    }
  },
  "networks": {
    "home-a": {
      "driver": "bridge",
      "driver_opts": {
        "com.docker.network.bridge.inhibit_ipv4": "true",
        "com.docker.network.bridge.enable_ip_masquerade": "false"
      },
      "ipam": {
        "config": [
          {
            "subnet": "${GYBLOS_P2P_HOME_A}",
            "gateway": "${GYBLOS_P2P_GATEWAY_A}"
          }
        ]
      }
    },
    "home-b": {
      "driver": "bridge",
      "driver_opts": {
        "com.docker.network.bridge.inhibit_ipv4": "true",
        "com.docker.network.bridge.enable_ip_masquerade": "false"
      },
      "ipam": {
        "config": [
          {
            "subnet": "${GYBLOS_P2P_HOME_B}",
            "gateway": "${GYBLOS_P2P_GATEWAY_B}"
          }
        ]
      }
    },
    "internet": {
      "driver": "bridge",
      "ipam": {
        "config": [
          {
            "subnet": "${GYBLOS_P2P_WAN}"
          }
        ]
      }
    }
  },
  "volumes": {
    "seller-data": {
      "name": "${GYBLOS_P2P_VOLUME_PREFIX}_seller-data",
      "external": true
    },
    "buyer-data": {
      "name": "${GYBLOS_P2P_VOLUME_PREFIX}_buyer-data",
      "external": true
    }
  }
}
