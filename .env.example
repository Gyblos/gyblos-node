# Optional. Only a devnet RPC is accepted; genesis hash is checked before use.
GYBLOS_RPC_URL=https://api.devnet.solana.com
# Keys are generated into .local/devnet by gate:setup. Never use mainnet wallets.
# GYBLOS_GATE_CONFIG=.local/devnet/config.json
# Iroh defaults to the owned relay; both seller and buyer use this relay set.
GYBLOS_RELAYS=https://na1.relay.gyblos.com/
# GYBLOS_RELAY_TOKEN is required. Supply it privately through the environment.
# There is no built-in token or automatic fallback to public n0 relays.
