# Optional. Only a devnet RPC is accepted; genesis hash is checked before use.
GYBLOS_RPC_URL=https://api.devnet.solana.com
# Keys are generated into .local/devnet by gate:setup. Never use mainnet wallets.
# GYBLOS_GATE_CONFIG=.local/devnet/config.json
# Iroh defaults to the owned relay; both seller and buyer use this relay set.
# GYBLOS_RELAYS overrides the built-in default (na1 only). Add na2 here, e.g.
# https://na1.relay.gyblos.com/,https://na2.relay.gyblos.com/, once it exists.
GYBLOS_RELAYS=https://na1.relay.gyblos.com/
# GYBLOS_RELAY_TOKEN is required (32-512 printable characters). Supply it
# privately through the environment. It is sent only to the exact owned hosts
# na1.relay.gyblos.com and na2.relay.gyblos.com; other configured relays receive
# no token. There is no built-in token or automatic fallback to public n0 relays.
# Optional buyer privacy mode: loopback-only binds (GYBLOS_IROH_BIND is ignored),
# relay-only dialing.
# GYBLOS_BUYER_RELAY_ONLY=1
