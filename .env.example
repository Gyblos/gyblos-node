# Documentation only: commands do NOT load .env files. Export the variables you
# need in the process environment. Never commit real values. Devnet only.

# --- Solana ---
# Devnet RPC; the genesis hash is checked before use.
# GYBLOS_RPC_URL=https://api.devnet.solana.com
# Gate config file written by `pnpm gate:setup`.
# GYBLOS_GATE_CONFIG=.local/devnet/config.json

# --- Iroh relays (seller and buyer) ---
# Required. 32-512 printable characters, supplied privately. Sent only to the
# owned hosts na1.relay.gyblos.com and na2.relay.gyblos.com. No built-in token.
# GYBLOS_RELAY_TOKEN=
# Optional override of the relay list (default: https://na1.relay.gyblos.com/).
# Both roles must use the same list. Example once na2 exists:
# GYBLOS_RELAYS=https://na1.relay.gyblos.com/,https://na2.relay.gyblos.com/

# --- Iroh binding and privacy ---
# Seller: relay only, loopback binds, no advertised direct addresses.
# GYBLOS_RELAY_ONLY=1
# Buyer: loopback binds (ignores GYBLOS_IROH_BIND), dial the seller via relay.
# GYBLOS_BUYER_RELAY_ONLY=1
# Local UDP bind address, e.g. 0.0.0.0:7000.
# GYBLOS_IROH_BIND=
# Extra public address to advertise; rejected in relay-only mode.
# GYBLOS_IROH_EXTERNAL_ADDR=
# Buyer: refuse to pay unless the route is iroh-direct or iroh-relay.
# GYBLOS_EXPECTED_ROUTE=iroh-direct

# --- Tests ---
# Run the opt-in local-validator identity tests.
# GYBLOS_IDENTITY_INTEGRATION=1
